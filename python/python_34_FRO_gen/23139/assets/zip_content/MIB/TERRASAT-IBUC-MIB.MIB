TERRASAT-IBUC-MIB DEFINITIONS ::= BEGIN

IMPORTS
        terrasat                
                FROM TERRASAT-SMI-MIB
        OBJECT-GROUP, NOTIFICATION-GROUP, MODULE-COMPLIANCE
                FROM SNMPv2-CONF
        ProtocolMode, NoYesValue, AlarmLevel, MsgResponseMode,
        DisableEnableValue, OffOnValue, PowerMonitorMode,
        GainMode, AlarmState, RedundancyEnable, RedundancyMode,
        PositionAB, RedundSwitchType, TxMute, PowerWatts,
        FrequencyBand, TenMHzMode
                FROM TERRASAT-TC-MIB
        IpAddress, OBJECT-TYPE, MODULE-IDENTITY, Integer32, NOTIFICATION-TYPE
                FROM SNMPv2-SMI
        sysName
                FROM RFC1213-MIB
        DisplayString
                FROM SNMPv2-TC;

ibucMIB MODULE-IDENTITY
    LAST-UPDATED    "202402270000Z"
    ORGANIZATION    "Terrasat Communications, Inc."
    CONTACT-INFO
            "Terrasat Communications
            Customer Service

            Address: 235 Vineyard Court
            Morgan Hill, CA  95037
            USA

            Tel: +1 408 782-2166

            E-mail: techsupport@terrasatinc.com"
    DESCRIPTION
        "The management MIB for IBUC products."

        REVISION        "202507180000Z"
        DESCRIPTION
                "Modified RF(Commercial added) and Reverse Power"
        REVISION        "202402270000Z"
        DESCRIPTION
                "Added ibucTxMultiBandSelect, ibucInputFreqRngSelect"

        REVISION        "202212060000Z"
        DESCRIPTION
                "Changed ibucPowerupDelay minimum to 30 seconds."

        REVISION        "202204150000Z"
        DESCRIPTION
                "Added ibucTxLoadSwitch oid."

        REVISION        "202202030000Z"
        DESCRIPTION
                "Changed the ranges for ibucInputThresholdLo,
		ibucInputThresholdHi, and ibucStatLogInterval."

        REVISION        "202005120000Z"
        DESCRIPTION
                "Added ibucPoutOffset."

        REVISION        "201810110000Z"
        DESCRIPTION
                "Added ibucKeylineDisable for IBUC3."

        REVISION        "201803130000Z"
        DESCRIPTION
                "Updated for M&C V2 firmware."

        REVISION        "201703310000Z"
        DESCRIPTION
                "Added ibucCouplingFactor."
        
        REVISION        "201609060000Z"
        DESCRIPTION
                "Corrected type mismatch of ibucAlarmLogType."
                
        REVISION        "201501220000Z"
        DESCRIPTION
                "Added ibucInputOverdriveFault."
                
        REVISION        "201412110000Z"
        DESCRIPTION
                "Added ibucBurstTimeout."
                
        REVISION        "201411120000Z"
        DESCRIPTION
                "Added 10MHzMode to imports section."
                
        REVISION        "201409090000Z"
        DESCRIPTION
                "Added ibuc10MHzSource."
                
        REVISION        "201407020000Z"
        DESCRIPTION
                "Added ibucWarmStandby."
                
        REVISION        "201406170000Z"
        DESCRIPTION
                "Changed ibucAttenuation range."
                
        REVISION    "201306070000Z"
        DESCRIPTION
                "Added ibucTotalSystemHours.
                 Added ibucTotalTransmitHours."

        REVISION    "201112120000Z"
        DESCRIPTION
                "Added notifications for individual alarms.
                 Added Redundant alarms."

        REVISION    "201109220000Z"
        DESCRIPTION
                "Added notifications ibucRebootEvent, ibucAlarmEvent, and 
                ibucAlarmClearEvent."

        REVISION    "201102080000Z"
        DESCRIPTION
                "Added ibucInternal10MHzTrim to ibucTx."

        REVISION    "201102040000Z"
        DESCRIPTION
                "Added AC Power supply Hertz adjustment."

        REVISION    "201012200000Z"
        DESCRIPTION
                "Changed the size of ibucModelNumber to 32 characters."

        REVISION        "200909280000Z"
        DESCRIPTION
                "The intial version."
    ::= { terrasat 1 }


ibucCfg			OBJECT IDENTIFIER ::= { ibucMIB 1 }
ibucIP			OBJECT IDENTIFIER ::= { ibucCfg 1 }
ibucRS485		OBJECT IDENTIFIER ::= { ibucCfg 2 }
ibucAlarm		OBJECT IDENTIFIER ::= { ibucCfg 3 }
ibucSystem		OBJECT IDENTIFIER ::= { ibucCfg 4 }
ibucTx			OBJECT IDENTIFIER ::= { ibucCfg 5 }
ibucRedund		OBJECT IDENTIFIER ::= { ibucCfg 6 }
ibucControl		OBJECT IDENTIFIER ::= { ibucMIB 2 }
ibucStatus		OBJECT IDENTIFIER ::= { ibucMIB 3 }
ibucUnitInfo	OBJECT IDENTIFIER ::= { ibucStatus 1 }
ibucAlarms		OBJECT IDENTIFIER ::= { ibucStatus 2 }
ibucDetector	OBJECT IDENTIFIER ::= { ibucStatus 3 }
ibucAlarmLog	OBJECT IDENTIFIER ::= { ibucStatus 4 }
ibucConformance	OBJECT IDENTIFIER ::= { ibucMIB 4 }
ibucEvents		OBJECT IDENTIFIER ::= { ibucMIB 5 }
ibucMonCtrlV2	OBJECT IDENTIFIER ::= { ibucMIB 6 }
ibucCompliances	OBJECT IDENTIFIER ::= { ibucConformance 1 }
ibucGroups		OBJECT IDENTIFIER ::= { ibucConformance 2 }
--
-- The Config Group
--

--
-- ip Subtree
--

-- 1.3.6.1.4.1.21369.1.1.1.1
ibucIPAddress OBJECT-TYPE
        SYNTAX  IpAddress
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the network IP address for this IBUC. Legal values are
        1.0.0.0 to 224.0.0.0 excluding the endpoints. xx.xx.xx.00
        and xx.xx.xx.255 are excluded also. This item requires an IBUC
        F/W reboot to take affect."
        ::= { ibucIP 1 }

-- 1.3.6.1.4.1.21369.1.1.1.2
ibucIPGateway OBJECT-TYPE
        SYNTAX  IpAddress
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the network IP gateway address for this IBUC. Legal 
        values are 1.0.0.0 to 224.0.0.0 excluding the endpoints.
        xx.xx.xx.00 and xx.xx.xx.255 are excluded also. This item 
        requires an IBUC F/W reboot to take affect."
        ::= { ibucIP 2 }

-- 1.3.6.1.4.1.21369.1.1.1.3
ibucIPSubnet OBJECT-TYPE
        SYNTAX  Integer32 ( 8..30)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the network IP subnet mask for this IBUC. Values range
        from 8 to 30. This is the number of 1 bits in the mask with 8 
        representing 255.0.0.0 and 30 representing 255.255.255.252.This 
        item requires an IBUC F/W reboot to take affect."
        ::= { ibucIP 3 }

-- 1.3.6.1.4.1.21369.1.1.1.4
ibucIPAddressOtherIBUC OBJECT-TYPE
        SYNTAX  IpAddress
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the network IP address of the other IBUC configured as
        a protected pair. Legal values are 1.0.0.0 to 224.0.0.0 
        excluding the endpoints. xx.xx.xx.00 and xx.xx.xx.255 
        are excluded also. This item requires an IBUC F/W reboot to take
        affect."
        ::= { ibucIP 4 }

-- 1.3.6.1.4.1.21369.1.1.1.5
ibucIPTelnetPort OBJECT-TYPE
        SYNTAX  Integer32 (1..65534)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the telnet port for this IBUC. Values can range from
        1 to 65534. This item requires an IBUC F/W reboot to take
        effect."
        ::= { ibucIP 5 }

--
-- rs485 Subtree
--

-- 1.3.6.1.4.1.21369.1.1.2.1
ibucRS485Address OBJECT-TYPE
        SYNTAX  Integer32 (1..254)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is 485 network address for this IBUC. Legal values are based
        on the setting of the rs485Mode below. If set to ASCII mode
        values can be 1 to 254. If set to Legacy binary values can be 1 to
        15."
        ::= { ibucRS485 1 }

-- 1.3.6.1.4.1.21369.1.1.2.2
ibucRS485Baudrate OBJECT-TYPE
        SYNTAX  Integer32 (1200|2400|4800|9600|19200|38400|56700|115200)
        UNITS           "baud"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the 485 baudrate of this IBUC. The only values supported are:
        1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200"
        ::= { ibucRS485 2 }

-- 1.3.6.1.4.1.21369.1.1.2.3
ibucRS485Mode OBJECT-TYPE
        SYNTAX  ProtocolMode
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the 485 protocol mode for this IBUC. Legal Values are
        (0) enable ASCII protocol
        (1) enable Legacy binary mode."
        ::= { ibucRS485 3 }

-- 1.3.6.1.4.1.21369.1.1.2.4
ibucRS485Delay OBJECT-TYPE
        SYNTAX  Integer32 (1..255)
        UNITS           "milliseconds"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the RS485 line delay for this IBUC. Legal Values are
        1 to 255 in milliseconds."
        ::= { ibucRS485 4 }

--
-- alarm Subtree
--

-- 1.3.6.1.4.1.21369.1.1.3.1
ibucTemperatureSuppressible OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures temperature alarm suppression.
        (0) disallow suppression
        (1) allow suppression"
        ::= { ibucAlarm 1 }

-- 1.3.6.1.4.1.21369.1.1.3.2
ibucInputLowThresholdSuppressible OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures Input Low Threshold
        alarm suppression.
        (0) disallow suppression
        (1) allow suppression"
        ::= { ibucAlarm 2 }

-- 1.3.6.1.4.1.21369.1.1.3.3
ibucInputHighThresholdSuppressible OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures Input High Threshold
        alarm suppression.
        (0) disallow suppression
        (1) allow suppression"
        ::= { ibucAlarm 3 }

-- 1.3.6.1.4.1.21369.1.1.3.4
ibucOutputLowThresholdSuppressible OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures Output Low Threshold
        alarm suppression.
        (0) disallow suppression
        (1) allow suppression"
        ::= { ibucAlarm 4 }

-- 1.3.6.1.4.1.21369.1.1.3.5
ibucOutputHighThresholdSuppressible OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures Output High Threshold
        alarm suppression.
        (0) disallow suppression
        (1) allow suppression"
        ::= { ibucAlarm 5 }

-- 1.3.6.1.4.1.21369.1.1.3.6
ibucTemperatureAlarmLevel OBJECT-TYPE
        SYNTAX  AlarmLevel
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures whether the Temperature alarm
        generates no alarm, a minor alarm, or a major alarm.
        (0) no alarm
        (1) minor alarm
        (2) major alarm"
        ::= { ibucAlarm 6 }

-- 1.3.6.1.4.1.21369.1.1.3.7
ibucInputLowThresholdAlarmLevel OBJECT-TYPE
        SYNTAX  AlarmLevel
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures whether the Input Low Threshold 
        alarm generates no alarm, a minor alarm, or a major alarm.
        (0) no alarm
        (1) minor alarm
        (2) major alarm"             
        ::= { ibucAlarm 7 }

-- 1.3.6.1.4.1.21369.1.1.3.8
ibucInputHighThresholdAlarmLevel OBJECT-TYPE
        SYNTAX  AlarmLevel
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures whether the Input High Threshold
        alarm generates no alarm, a minor alarm, or a major alarm.
        (0) no alarm
        (1) minor alarm
        (2) major alarm"             
        ::= { ibucAlarm 8 }

-- 1.3.6.1.4.1.21369.1.1.3.9
ibucOutputLowThresholdAlarmLevel OBJECT-TYPE
        SYNTAX  AlarmLevel
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures whether the Output Low Threshold
        alarm generates no alarm, a minor alarm, or a major alarm.
        (0) no alarm
        (1) minor alarm
        (2) major alarm"             
        ::= { ibucAlarm 9 }

-- 1.3.6.1.4.1.21369.1.1.3.10
ibucOutputHighThresholdAlarmLevel OBJECT-TYPE
        SYNTAX  AlarmLevel
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures whether the Output High Threshold
        alarm generates no alarm, a minor alarm, or a major alarm.
        (0) no alarm
        (1) minor alarm
        (2) major alarm"             
        ::= { ibucAlarm 10 }

-- 1.3.6.1.4.1.21369.1.1.3.11
ibucTemperatureShutdownThreshold OBJECT-TYPE
        SYNTAX          Integer32 (65..85)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the internal temperature threshold for muting the PA
		to avoid over temperature damage"             
        ::= { ibucAlarm 11 }

--
-- system Subtree
--

-- 1.3.6.1.4.1.21369.1.1.4.1
ibucVerboseMode OBJECT-TYPE
        SYNTAX  MsgResponseMode
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object sets the response type for messages
        utilizing the telnet command set.
        (0) Terse messages   (no formatting)
        (1) Verbose messages (formatted output)"
        ::= { ibucSystem 1 }

-- 1.3.6.1.4.1.21369.1.1.4.2
ibucEcho OBJECT-TYPE
        SYNTAX  DisableEnableValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object sets the echo type for messages
        utilizing the telnet command set.
        (0) No Echo (no response from the unit on Set commands)
        (1) Echo (IBUC echoes any Set command back to user)"
        ::= { ibucSystem 2 }

-- 1.3.6.1.4.1.21369.1.1.4.3
ibucPasswordTimeOut OBJECT-TYPE
        SYNTAX          Integer32 (0..65535)
        UNITS           "minutes"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object sets the password timeout for all
        interfaces excluding snmp.
        (0) no password timeout
        (1..65535) number of minutes"
        ::= { ibucSystem 3 }

-- 1.3.6.1.4.1.21369.1.1.4.4
ibucWebServerRefresh OBJECT-TYPE
        SYNTAX  Integer32 (0..3600)
        UNITS           "seconds"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object sets the web server refresh rate
        (0) no refresh
        (1..3600) number of seconds"
        ::= { ibucSystem 4 }

-- 1.3.6.1.4.1.21369.1.1.4.5
ibucAC50HzCorrection OBJECT-TYPE
        SYNTAX  DisableEnableValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object sets the AC power supply frequency correction
        (0) Disable
        (1) Enable"
        ::= { ibucSystem 5 }

--
-- tx Subtree
--

-- 1.3.6.1.4.1.21369.1.1.5.1
ibucFrequency OBJECT-TYPE
        SYNTAX  Integer32 (1..65535)
        UNITS           "MHz"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        monitored frequency in MHz at the output of the IBUC.
        This can be input as an IF or RF frequency inside the
        passband of the unit."
        ::= { ibucTx 1 }

-- 1.3.6.1.4.1.21369.1.1.5.2
ibucPowerupState OBJECT-TYPE
        SYNTAX  OffOnValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        powerup state of the IBUC transmitter.
        (0) TX OFF
        (1) TX ON"
        ::= { ibucTx 2 }

-- 1.3.6.1.4.1.21369.1.1.5.3
ibucPowerupDelay OBJECT-TYPE
        SYNTAX  Integer32 (30..500)
        UNITS           "seconds"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        powerup delay of the IBUC Transmitter before enabling.
        30-500 in 1 second intervals."
        ::= { ibucTx 3 }

-- 1.3.6.1.4.1.21369.1.1.5.4
ibucReadPowerMode OBJECT-TYPE
        SYNTAX  PowerMonitorMode
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        mode the IBUC reports its output power level.
        (0) Continuous Signal Mode
        (1) Burst Mode"
        ::= { ibucTx 4 }

-- 1.3.6.1.4.1.21369.1.1.5.5
ibucBurstThreshold OBJECT-TYPE
        SYNTAX  Integer32 (1..65535)
        UNITS           "millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        burst threshold setting of the IBUC. 0 to 6000 millibels
        further qualified by the power output range. Rated Power + 1
        to Rated Power - 20 db."
        ::= { ibucTx 5 }

-- 1.3.6.1.4.1.21369.1.1.5.6
ibucBurstCount OBJECT-TYPE
        SYNTAX  Integer32 (1..16)
        UNITS           "samples"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        number of readings to sample in the burst power measurement.
        Ranges from 1 - 16"
        ::= { ibucTx 6 }

-- 1.3.6.1.4.1.21369.1.1.5.7
ibucGainMode OBJECT-TYPE
        SYNTAX  GainMode
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        gain mode of the IBUC.
        (0) Open Loop
        (1) ALC
        (2) AGC"
        ::= { ibucTx 7 }

-- 1.3.6.1.4.1.21369.1.1.5.8
ibucAttenuation OBJECT-TYPE
        SYNTAX  Integer32 (0..3000)
        UNITS           "millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        attenuation setting of this IBUC. If the IBUC is 
        Option Z this has no meaning and writes will return
        snmp error.
        Ranges from 0 to 1600 millibels
        Option -002 0 to 2000 millibels
        IBR 0 to 3000 millibels"
        ::= { ibucTx 8 }

-- 1.3.6.1.4.1.21369.1.1.5.9
ibucInputThresholdLo OBJECT-TYPE
        SYNTAX  Integer32 (-9900..9900)
        UNITS           "millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        Input Low Threshold setting in millibels for this IBUC.
        Range is -9900 to -9900.
        Must be below cfgInputThresholdHigh."
        ::= { ibucTx 9 }

-- 1.3.6.1.4.1.21369.1.1.5.10
ibucInputThresholdHi OBJECT-TYPE
        SYNTAX  Integer32 (-9900..9900)
        UNITS           "millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        Input High Threshold setting in millibels for this IBUC. 
        Range is -9900 to 9900
        Must be above cfgInputThresholdLow."
        ::= { ibucTx 10 }

-- 1.3.6.1.4.1.21369.1.1.5.11
ibucOutputThresholdLo OBJECT-TYPE
        SYNTAX  Integer32 (0..6000)
        UNITS           "millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        Output Low Threshold setting in milliBels for this IBUC. 
        Range is 0 to 6000 further qualified by the output
        range of the IBUC(Rated Power to Rated Power - 20 db).
        Must be below cfgInputThresholdHigh."
        ::= { ibucTx 11 }

-- 1.3.6.1.4.1.21369.1.1.5.12
ibucOutputThresholdHi OBJECT-TYPE
        SYNTAX  Integer32 (0..6000)
        UNITS           "millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        Output High Threshold setting for this IBUC. 0 to 6000
        millibels. Further qualified by the output
        range of the IBUC(Rated Power+1dB to Rated Power - 20 dB).
        Must be above cfgOutputThresholdLow."
        ::= { ibucTx 12 }

-- 1.3.6.1.4.1.21369.1.1.5.13
ibucHighTemperatureShutdown OBJECT-TYPE
        SYNTAX  DisableEnableValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        High Temperature Shutdown. Enables or disables the
        high temp TX shutdown when temperature exceeds ratings.
        (0) Disables
        (1) Enables"
        ::= { ibucTx 13 }

-- 1.3.6.1.4.1.21369.1.1.5.14
ibucZAttenuation OBJECT-TYPE
        SYNTAX  Integer32 (0..4000)
        UNITS           "millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        40 dB attenuation setting of this IBUC. If
        the IBUC is not Option Z this return value has no
        meaning, and writes will return snmp error.
        Ranges from 0 to 4000 millibels."
        ::= { ibucTx 14 }

-- 1.3.6.1.4.1.21369.1.1.5.15
ibucZLevelTarget OBJECT-TYPE
        SYNTAX  Integer32 (0..6000)
        UNITS           "millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        level target for ALC mode of this IBUC. If the IBUC
        is not Option Z this return value has no meaning,
        and writes will return an snmp error.
        Ranges from 0 to 6000 millibels."
        ::= { ibucTx 15 }

-- 1.3.6.1.4.1.21369.1.1.5.16
ibucZGainTarget OBJECT-TYPE
        SYNTAX  Integer32 (0..9900)
        UNITS           "millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        gain target for AGC mode of this IBUC. If the IBUC
        is not Option Z this return value has no meaning,
        and writes will return an snmp error.
        Ranges from 0 to 9900 millibels."
        ::= { ibucTx 16 }

-- 1.3.6.1.4.1.21369.1.1.5.17
ibucInternal10MHzTrim OBJECT-TYPE
        SYNTAX  Integer32 (0..255)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This value modifies the internal 10 MHz oscillator
        frequency on IBUC option I only."
        ::= { ibucTx 17 }

-- 1.3.6.1.4.1.21369.1.1.5.18
ibucBurstTimeout OBJECT-TYPE
        SYNTAX  Integer32 (0..300)
		UNITS	"seconds"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This value modifies the burst time out period."
        ::= { ibucTx 18 }

-- 1.3.6.1.4.1.21369.1.1.5.19
ibucCouplingFactor OBJECT-TYPE
        SYNTAX  Integer32 (-32768..32767)
		UNITS	"millibels"
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "For units equipped with an output sample port,
		this is the coupling factor in milliBels."
        ::= { ibucTx 19 }

-- 1.3.6.1.4.1.21369.1.1.5.20
ibucReverseThresholdHi OBJECT-TYPE
        SYNTAX  Integer32 (0..6000)
		UNITS	"millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        Reverse High Threshold setting for this IBUC. 0 to 6000
        millibels. Further qualified by the output
        range of the IBUC(Rated Power +1dB to Rated Power -20 dB).
        Must be above cfgOutputThresholdLow."
        ::= { ibucTx 20 }
		
-- 
-- redund Subtree
--

-- 1.3.6.1.4.1.21369.1.1.6.1
ibucRedundancyEnabled OBJECT-TYPE
        SYNTAX  RedundancyEnable
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        redundancy mode of the IBUC.
        (0) Not redundant
        (1) Redundancy enabled"
        ::= { ibucRedund 1 }

-- 1.3.6.1.4.1.21369.1.1.6.2
ibucRedundancyMode OBJECT-TYPE
        SYNTAX  RedundancyMode
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        redundancy switching mode of IBUC.
        Valid only if redundancyEnabled is 1.
        (0) Reverting
        (1) NonReverting"
        ::= { ibucRedund 2 }

-- 1.3.6.1.4.1.21369.1.1.6.3
ibucPositionOnSwitch OBJECT-TYPE
        SYNTAX  PositionAB
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        position of the IBUC on the waveguide switch.
        Valid only if redundancyEnabled is 1.
        (0) A side
        (1) B side"
        ::= { ibucRedund 3 }

-- 1.3.6.1.4.1.21369.1.1.6.4
ibucAutoCloning OBJECT-TYPE
        SYNTAX  DisableEnableValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        cloning mode the IBUC.
        Valid only if redundancyEnabled is 1.
        (0) Disable automatic cloning of configuration data to slave.
        (1) Enable automatic cloning of configuration data to slave."
        ::= { ibucRedund 4 }

-- 1.3.6.1.4.1.21369.1.1.6.5
ibucSwitchingType OBJECT-TYPE
        SYNTAX  RedundSwitchType
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        switching type of the IBUC.
        Valid only if redundancyEnabled is 1.
        (0) Manual switching
        (1) Automatic switching"
        ::= { ibucRedund 5 }

-- 1.3.6.1.4.1.21369.1.1.6.6
ibucSwitchPosition OBJECT-TYPE
        SYNTAX  PositionAB
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        switch positon of the IBUC. Reading this variable
        shows the current waveguide switch position. Writing
        this variable changes the current switch position.
        Valid only if redundancyEnabled is 1.
        (0) Switch position A
        (1) Switch position B"
        ::= { ibucRedund 6 }

-- 1.3.6.1.4.1.21369.1.1.6.7
ibucSystemStatus OBJECT-TYPE
        SYNTAX  OCTET STRING (SIZE (0..100))
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        redundant system status of the IBUC.
        Valid only if redundancyEnabled is 1."
        ::= { ibucRedund 7 }

-- 1.3.6.1.4.1.21369.1.1.6.8
ibucWarmStandby OBJECT-TYPE
        SYNTAX  DisableEnableValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        redundancy switching mode of IBUC.
        Valid only if redundancyEnabled is 1.
        (0) Hot Standby(Standby PA not muted
        (1) Warm Standby(Standby PA muted"
        ::= { ibucRedund 8 }
        
          --
          -- The Control Group
          --

-- 1.3.6.1.4.1.21369.1.2.1
ibucSuppressAlarms OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object causes configured threshold
        alarms to be suppressed.
        (0) No Suppression
        (1) Suppress configured threshold alarms"
        ::= { ibucControl 1 }

-- 1.3.6.1.4.1.21369.1.2.2
ibucSimulateAlarm OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object causes a major alarm
        in the IBUC.
        (0) No Alarm
        (1) Simulate a Tx alarm"
        ::= { ibucControl 2 }

-- 1.3.6.1.4.1.21369.1.2.3
ibucClearAlarmLog OBJECT-TYPE
        SYNTAX  Integer32 (0)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object causes the IBUC to clear
        its alarm history."
        ::= { ibucControl 3 }

-- 1.3.6.1.4.1.21369.1.2.4
ibucMute OBJECT-TYPE
        SYNTAX  TxMute
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object causes the transmitter to
        be muted.
        (0) Transmit disabled.
        (1) Transmit enabled.
        (2) Transmit muted due to alarms.
        (3) Transmit muted from external pin.
        (4) Transmit muted due to power up delay."
        ::= { ibucControl 4 }

-- 1.3.6.1.4.1.21369.1.2.5
ibucResetGainControl OBJECT-TYPE
        SYNTAX  Integer32 (0)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object causes the Gain Control
        attenuator to be reset to 0 db. If this IBUC is 
        Option Z then this will return snmp error.
        (0) Reset Gain Control"
        ::= { ibucControl 5 }

-- 1.3.6.1.4.1.21369.1.2.6
ibucFirmwareReboot OBJECT-TYPE
        SYNTAX  Integer32 (0)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object causes the firmware to
        restart. Writing this object will cause a momentary
        interruption to traffic.
        (0) Reboot Firmware"
        ::= { ibucControl 6 }

