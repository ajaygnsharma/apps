--
-- statusDetector Subtree
--

-- 1.3.6.1.4.1.21369.1.3.3.1
ibucSupplyVoltage OBJECT-TYPE
        SYNTAX  Integer32 (1..3000)
		UNITS	"decivolts"
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies the
        AC/DC voltage level of the IBUC. Values range
        from 0 to 600 decivolts for DC supplied IBUCs
        and 0 to 3000 decivolts for AC supplied IBUCs."
        ::= { ibucDetector 1 }

-- 1.3.6.1.4.1.21369.1.3.3.2
ibucSupplyCurrent OBJECT-TYPE
        SYNTAX  Integer32 (1..250)
		UNITS	"deciamps"
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies the
        AC/DC current consumption of the IBUC. Values range
        from 0 to 250 deciamps."
        ::= { ibucDetector 2 }

-- 1.3.6.1.4.1.21369.1.3.3.3
ibucDROVoltage OBJECT-TYPE
        SYNTAX  Integer32 (1..100)
		UNITS	"decivolts"
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies the
        DRO voltage of the IBUC. Values range
        from 0 to 100 decivolts. This value has no
		meaning for IBUC3 since it has a synthesizer.
		It is defaulted to 0 for IBUC3."
        ::= { ibucDetector 3 }

-- 1.3.6.1.4.1.21369.1.3.3.4
ibucTemperature OBJECT-TYPE
        SYNTAX  Integer32 (-127..100)
		UNITS	"degrees C"
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies the
        internal temperature level of the IBUC. Values range
        from -50C to 100C in 1 degree C increments. -127 indicates
        out of range."
        ::= { ibucDetector 4 }

-- 1.3.6.1.4.1.21369.1.3.3.5
ibucGainControl OBJECT-TYPE
        SYNTAX  Integer32 (1..65535)
		UNITS	"millibels"
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies the
        gain control level of the IBUC. Values range
        from -800 db to +800 millibels in 1 millibel increments."
        ::= { ibucDetector 5 }

-- 1.3.6.1.4.1.21369.1.3.3.6
ibucInputPowerLevel OBJECT-TYPE
        SYNTAX  Integer32 (-6000..-1500)
		UNITS	"millibels"
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies the
        input power level of the IBUC. Values range
        from -1500 to -6000 millibels."
        ::= { ibucDetector 6 }


-- 1.3.6.1.4.1.21369.1.3.3.7
ibucOutputPowerLevel OBJECT-TYPE
        SYNTAX  Integer32 (-9900..6000)
		UNITS	"millibels"
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies the
        output power level of the IBUC. Values range
        from 0 to 6000 millibels.
        (-9600) IBUC Out of Lock.
        (-9900) IBUC is muted."
        ::= { ibucDetector 7 }

-- 1.3.6.1.4.1.21369.1.3.3.8
ibuc10MHzSource OBJECT-TYPE
        SYNTAX  TenMHzMode
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "This identifies the the 10MHz source
        currently driving the DRO or synthesizer(IBUC3).
        (0) Internal 10MHz.
        (1) External 10MHz."
        ::= { ibucDetector 8 }

--
-- alarmLog Subtree
--

-- 1.3.6.1.4.1.21369.1.3.4.1
ibucAlarmLogNumber OBJECT-TYPE
        SYNTAX  Integer32 (1..40)
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies the
        current number of alarm log entries."
        ::= { ibucAlarmLog 1 }

ibucAlarmLogTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF IbucAlarmLogEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "This is a table of alarm log entries."
        ::= { ibucAlarmLog 2 }

ibucAlarmLogEntry OBJECT-TYPE
        SYNTAX  IbucAlarmLogEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "This is a table of alarm log entries."
        INDEX {ibucAlarmLogIndex}
        ::= { ibucAlarmLogTable 1 }

IbucAlarmLogEntry ::= SEQUENCE {
        ibucAlarmLogIndex               Integer32,
        ibucAlarmLogType                INTEGER,
        ibucAlarmLogAlarms              Integer32
}

ibucAlarmLogIndex OBJECT-TYPE
        SYNTAX  Integer32 (1..40)
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies this
        alarm log entry."
        ::= { ibucAlarmLogEntry 1 }

-- 1.3.6.1.4.1.21369.1.3.4.2.1.2
ibucAlarmLogType OBJECT-TYPE
        SYNTAX  INTEGER {tx(0), misc(1)}
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies this
        alarm log entry's alarm type
        (0) Tx Alarms
        (1) Misc Alarms."
        ::= { ibucAlarmLogEntry 2 }

-- 1.3.6.1.4.1.21369.1.3.4.2.1.3
ibucAlarmLogAlarms OBJECT-TYPE
        SYNTAX  Integer32 (1..65535)
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object uniquely identifies this
        alarm log entry's alarms. The values of this entry 
        is based on the value of the 0x8000 bit.
        If the value is 0 then the following bitmap applies:

        (0x0001) AGC/ALC out of range
        (0x0002) AGC/ALC not settled
        (0x0004) Loss of lock
        (0x0008) Output level high
        (0x0010) Output level low
        (0x0020) Input level high
        (0x0040) Input level low
        (0x0080) Over maximum temperature
        (0x0100) Tx simulated
        (0x0200) 10 MHz reference
        (0x0400) AC/DC voltage out of range
        (0x0800) Waveguide switch fault
        (0x1000) Not used
        (0x2000) AC/DC current out of range
        (0x4000) AGC/ALC target out of range
        (0x8000) Not used

        If the value is 1 then the following bitmap applies:

        (0x0001) Event log corrupted
        (0x0002) Configuration reset
        (0x0004) Ethernet download
        (0x0008) Serial download
        (0x0010) Reboot
        (0x0020) Clone communications fault
        (0x0040) Clone read fault
        (0x0080) Clone write fault
        (0xFF00) Not used"
        ::= { ibucAlarmLogEntry 3 }

--
-- ibucMonCtrlV2
--		
		
-- 1.3.6.1.4.1.21369.1.6.1
ibucIPAddressOtherPublic OBJECT-TYPE
        SYNTAX  IpAddress
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "When redundancy is enabled this gives the public address of the
        other BUC when using port forwarding on a router. This is only 
		needed by the web server."
        ::= { ibucMonCtrlV2 1 }
		
-- 1.3.6.1.4.1.21369.1.6.2
ibucRealTimeClock OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (19))
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the real time clock of the IBUC.
        Format is MM/dd/yyyy hh:mm:ss.
        Time is based on 24 hour clock."
        ::= { ibucMonCtrlV2 2 }
        
-- 1.3.6.1.4.1.21369.1.6.3
ibucNtpIpAddr OBJECT-TYPE
        SYNTAX  IpAddress
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the NTP server IP address. Legal values are
        1.0.0.0 to 224.0.0.0 excluding network, loopback,
        and broadcast addresses. 0.0.0.0 disables NTP."
        ::= { ibucMonCtrlV2 3 }

-- 1.3.6.1.4.1.21369.1.6.4
ibucTimezoneOffset OBJECT-TYPE
        SYNTAX  Integer32 (-720..840)
		UNITS	"minutes"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the offset for GMT served by NTP. It may range from
        GMT+14 to GMT-12."
        ::= { ibucMonCtrlV2 4 }
        
-- 1.3.6.1.4.1.21369.1.6.5
ibucWebPageTitle OBJECT-TYPE
        SYNTAX  DisplayString (SIZE (0..32))
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the user configurable title displayed at the top
        of web pages."
        ::= { ibucMonCtrlV2 5 }
        
-- 1.3.6.1.4.1.21369.1.6.6
ibucEnableExtLED OBJECT-TYPE
        SYNTAX  DisableEnableValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object sets the external LED.
        (0) LED is disabled for display of alarms.
        (1) LED is enabled for display of alarms"
        ::= { ibucMonCtrlV2 6 }
		
-- 1.3.6.1.4.1.21369.1.6.7
ibucInternal10MHzV2Trim OBJECT-TYPE
        SYNTAX  Integer32 (0..4095)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This value modifies the internal 10 MHz oscillator
		for F/W revisions greater than or equal to 5.00 (V2 M&C)
		For revisions below 5.00 (V1 M&C) use ibucInternal10MHzTrim."
        ::= { ibucMonCtrlV2 7 }
		
-- 1.3.6.1.4.1.21369.1.6.8
ibucHardwareVersion OBJECT-TYPE
        SYNTAX  DisplayString
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "This is the hardware revision of the unit."
        ::= { ibucMonCtrlV2 8 }
  
-- 1.3.6.1.4.1.21369.1.6.9
ibucRFRange OBJECT-TYPE
        SYNTAX  DisplayString
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "This is the RF frequency range of this unit."
        ::= { ibucMonCtrlV2 9 }

-- 1.3.6.1.4.1.21369.1.6.10
ibucIFRange OBJECT-TYPE
        SYNTAX  DisplayString
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "This is the IF frequency range of this unit."
        ::= { ibucMonCtrlV2 10 }

-- 1.3.6.1.4.1.21369.1.6.11
ibucLOFrequency OBJECT-TYPE
        SYNTAX  DisplayString
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "This is the frequency of the local oscillator
        of this unit."
        ::= { ibucMonCtrlV2 11 }
        
-- 1.3.6.1.4.1.21369.1.6.12
ibucSpectralInversion OBJECT-TYPE
        SYNTAX  DisplayString
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "This gives the type inversion of the unit."
        ::= { ibucMonCtrlV2 12 }
        
-- 1.3.6.1.4.1.21369.1.6.13
ibucVoltageRange OBJECT-TYPE
        SYNTAX  DisplayString
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "This is the operating voltage range of the unit."
        ::= { ibucMonCtrlV2 13 }

-- 1.3.6.1.4.1.21369.1.6.14
ibucInternal10MHz OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies whether
        internal 10MHz is installed in this unit."
        ::= { ibucMonCtrlV2 14 }
		
-- 1.3.6.1.4.1.21369.1.6.15
ibucTxMutedFault OBJECT-TYPE
        SYNTAX  AlarmState
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "This identifies whether the transmitter
        is muted either by an alarm condition or
        the user disabling the transmitter."
        ::= { ibucMonCtrlV2 15 }
		
--
-- Alarm Log table for V2 Monitor and Control.
--

ibucEventLogTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF IbucEventLogEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "This is a table of alarm log entries
		for Version 2 Monitor and Control cards
		with firmware versions greater than or
		equal to 5.00."
        ::= { ibucMonCtrlV2 16 }


ibucEventLogEntry OBJECT-TYPE
        SYNTAX  IbucEventLogEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "This is a table of alarm log entries."
        INDEX {ibucEventLogIndex}
        ::= { ibucEventLogTable 1 }

IbucEventLogEntry ::= SEQUENCE {
        ibucEventLogIndex                Integer32,
        ibucEventLogEvent                DisplayString
}

ibucEventLogIndex OBJECT-TYPE
        SYNTAX  Integer32 (1..1000)
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "Index to the table."
        ::= { ibucEventLogEntry 1 }

-- 1.3.6.1.4.1.21369.1.6.16.1.2
ibucEventLogEvent OBJECT-TYPE
        SYNTAX  DisplayString
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies this
        alarm log entry's alarm."
        ::= { ibucEventLogEntry 2 }
		
-- 1.3.6.1.4.1.21369.1.6.17
ibucClearStatLog OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object clears the statistics
        history."
        ::= { ibucMonCtrlV2 17 }

-- 1.3.6.1.4.1.21369.1.6.18
ibucStatLogInterval OBJECT-TYPE
        SYNTAX  Integer32 (0..1440)
		UNITS	"minutes"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "Statistics collection interval
		1 minute to 1440 minutes
		0 disables statistics."
        ::= { ibucMonCtrlV2 18 }
		
ibucStatLogTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF IbucStatLogEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "This is a table of statistics log entries."
        ::= { ibucMonCtrlV2 19 }

ibucStatLogEntry OBJECT-TYPE
        SYNTAX  IbucStatLogEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "This is a table of statistics log entries."
        INDEX {ibucStatLogIndex}
        ::= { ibucStatLogTable 1 }

IbucStatLogEntry ::= SEQUENCE {
        ibucStatLogIndex                Integer32,
        ibucStatLogValue                DisplayString
}

ibucStatLogIndex OBJECT-TYPE
        SYNTAX  Integer32 (1..1000)
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "Index to the table."
        ::= { ibucStatLogEntry 1 }

-- 1.3.6.1.4.1.21369.1.6.19.1.2
ibucStatLogValue OBJECT-TYPE
        SYNTAX  DisplayString
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies above
		statistics entry. DRO always reads 0 for IBUC3.
		Format:
		date time Pout Pin Temperature DRO Volts Amps 10MHz
		Example:
		01/01/2000 09:08:23 47.5 -35.9 25 5.5 48.0 2.5 -10.8"
        ::= { ibucStatLogEntry 2 }
	
-- 1.3.6.1.4.1.21369.1.6.20
ibucKeylineDisable OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "IBUC3 keyline disable. 0 - enable keyline external
		control. 1 - disable keyline external control. Used
		on IBUC model numbers starting with IBA."
        ::= { ibucMonCtrlV2 20 }

-- 1.3.6.1.4.1.21369.1.6.21
ibucPoutOffset OBJECT-TYPE
        SYNTAX  Integer32 (-300..300)
        UNITS           "millibels"
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This can be configured to offset the power out
		reading. Power out may be offset -300 to 300 millibels."
        ::= { ibucMonCtrlV2 21 }
	
-- 1.3.6.1.4.1.21369.1.6.22
ibucTXLoadSwitch OBJECT-TYPE
        SYNTAX  INTEGER {antenna(0), load(1)}
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This variable applies only to non-protected
	BUCs connected to a waveguide switch.
        The value of this object uniquely identifies the
        transmit load switch positon of the IBUC. Reading 
        this variable shows the current transmit load switch 
        position. Writing this variable changes the 
        current switch position.
        Valid only if redundancyEnabled is 1.
        (0) Transmit to antenna.
        (1) Transmit to Load."
        ::= { ibucMonCtrlV2 22 }

-- 1.3.6.1.4.1.21369.1.6.23
ibucTXMultiBandSelect OBJECT-TYPE
        SYNTAX  Integer32 (0..5)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures the RF band.
        (0) Single Band
        (1) Commercial RF Band 1
        (2) Commercial RF Band 2
        (3) Commercial RF Band 3
        (4) Military RF Band 1
        (5) Military RF Band 2"
        ::= { ibucMonCtrlV2 23 }

-- 1.3.6.1.4.1.21369.1.6.24
ibucIFSelect OBJECT-TYPE
        SYNTAX  Integer32 (0..1)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object configures the IF band.
        (0) IF Band 1 (1-2 GHz)
        (1) IF Band 2 (950-1950 MHz)"
        ::= { ibucMonCtrlV2 24 }


ibucEventsV2    OBJECT IDENTIFIER ::= { ibucEvents 0 }

ibucRebootEvent NOTIFICATION-TYPE
        OBJECTS { 
                sysName
        }
        STATUS current
        DESCRIPTION
        "The trap is issued on cold or warm startup of firmware."
        ::= {ibucEventsV2 1}



ibucAlarmEvent NOTIFICATION-TYPE
        OBJECTS { 
                ibucDROLock,
                ibucAgcAlcNotSettled,
                ibucAgcAlcTargetOOR,
                ibucInputThresholdLow,
                ibucInputThresholdHigh,
                ibucOutputThresholdLow,
                ibucOutputThresholdHigh,
                ibuc10MHz,
                ibucAgcAlcRange,
                ibucTemperatureAlarm,
                ibucTxSimulated,
                ibucSupplyVoltageOor,
                ibucSupplyCurrentOor,
                ibucLogAlignError,
                ibucCfgDataError,
                ibucEthernetDownload,
                ibucSerialDownload,
                ibucFWReboot
        }
        STATUS current
        DESCRIPTION
        "This indicates an alarm has occurred with severity level indicated."
        ::= {ibucEventsV2 2}

ibucAlarmClearEvent NOTIFICATION-TYPE
        OBJECTS { 
                ibucDROLock,
                ibucAgcAlcNotSettled,
                ibucAgcAlcTargetOOR,
                ibucInputThresholdLow,
                ibucInputThresholdHigh,
                ibucOutputThresholdLow,
                ibucOutputThresholdHigh,
                ibuc10MHz,
                ibucAgcAlcRange,
                ibucTemperatureAlarm,
                ibucTxSimulated,
                ibucSupplyVoltageOor,
                ibucSupplyCurrentOor,
                ibucLogAlignError,
                ibucCfgDataError,
                ibucEthernetDownload,
                ibucSerialDownload,
                ibucFWReboot
        }
        STATUS current
        DESCRIPTION
        "This indicates an alarm has cleared."
        ::= {ibucEventsV2 3}

ibucDROLockMajorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates a Major DRO/Synthesizer lock alarm has occurred."
        ::= {ibucEventsV2 4}

ibucDROLockClearEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates the DRO/Synthesizer lock alarm has cleared."
        ::= {ibucEventsV2 5}

ibucInputThresholdLowMajorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an major input low threshold alarm has occurred."
        ::= {ibucEventsV2 6}

ibucInputThresholdLowMinorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an minor input low threshold alarm has occurred."
        ::= {ibucEventsV2 7}

ibucInputThresholdLowClearEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an input low threshold alarm has cleared."
        ::= {ibucEventsV2 8}

ibucInputThresholdHighMajorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an major input high threshold alarm has occurred."
        ::= {ibucEventsV2 9}

ibucInputThresholdHighMinorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an minor input high threshold alarm has occurred."
        ::= {ibucEventsV2 10}

ibucInputThresholdHighClearEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an input high threshold alarm has cleared."
        ::= {ibucEventsV2 11}

ibucOutputThresholdLowMajorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an major output low threshold alarm has occurred."
        ::= {ibucEventsV2 12}

ibucOutputThresholdLowMinorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an minor output low threshold alarm has occurred."
        ::= {ibucEventsV2 13}

ibucOutputThresholdLowClearEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an output low threshold alarm has cleared."
        ::= {ibucEventsV2 14}

ibucOutputThresholdHighMajorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an major output high threshold alarm has occurred."
        ::= {ibucEventsV2 15}

ibucOutputThresholdHighMinorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an minor output high threshold alarm has occurred."
        ::= {ibucEventsV2 16}

ibucOutputThresholdHighClearEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates an output high threshold alarm has cleared."
        ::= {ibucEventsV2 17}

ibuc10MHzMinorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates a minor 10 MHz input alarm has occurred."
        ::= {ibucEventsV2 18}

ibuc10MHzClearEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates a 10 MHz input alarm has cleared."
        ::= {ibucEventsV2 19}

ibucTemperatureMajorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates a major temperature alarm has occurred."
        ::= {ibucEventsV2 20}

ibucTemperatureMinorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates a minor temperature alarm has occurred."
        ::= {ibucEventsV2 21}

ibucTemperatureClearEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates a temperature alarm has cleared."
        ::= {ibucEventsV2 22}

ibucTxSimulatedMajorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates a Major TX simulated alarm has occurred."
        ::= {ibucEventsV2 23}

ibucTxSimulatedClearEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates a TX simulated alarm has cleared."
        ::= {ibucEventsV2 24}

ibucSupplyVoltageOorMinorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates a minor supply voltage alarm has occurred."
        ::= {ibucEventsV2 25}

ibucSupplyVoltageOorClearEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates supply voltage alarm has cleared."
        ::= {ibucEventsV2 26}

ibucWGSwitchFaultMajorEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates a waveguide switch alarm has occurred."
        ::= {ibucEventsV2 27}

ibucWGSwitchFaultClearEvent NOTIFICATION-TYPE
        STATUS current
        DESCRIPTION
        "This indicates waveguide switch alarm has cleared."
        ::= {ibucEventsV2 28}

-- 1.3.6.1.4.1.21369.1.5.0.29
ibucInputOverdriveEvent NOTIFICATION-TYPE
        OBJECTS { ibucInputOverdriveFault }
        STATUS current
        DESCRIPTION
        "This indicates a change in the state of the IF input 
        overdrive alarm."
        ::= {ibucEventsV2 29}
        
-- 1.3.6.1.4.1.21369.1.5.0.30
ibucTxMutedEvent NOTIFICATION-TYPE
        OBJECTS { ibucTxMutedFault }
        STATUS current
        DESCRIPTION
        "This indicates a change in the mute state of the
        transmitter."
        ::= {ibucEventsV2 30}

-- 1.3.6.1.4.1.21369.1.5.0.31
ibucAgcAlcRangeEvent NOTIFICATION-TYPE
        OBJECTS { ibucAgcAlcRange }
        STATUS current
        DESCRIPTION
        "This indicates AGC/ALC has run out of attenuator
        range to correct the level."
        ::= {ibucEventsV2 31}

-- 1.3.6.1.4.1.21369.1.5.0.32
ibucAgcAlcTargetOOREvent NOTIFICATION-TYPE
        OBJECTS { ibucAgcAlcTargetOOR }
        STATUS current
        DESCRIPTION
        "This indicates the AGC/ALC target level is out of
        range of the input/output detector calibration range."
        ::= {ibucEventsV2 32}

-- 1.3.6.1.4.1.21369.1.5.0.33
ibucCloneCommFaultEvent NOTIFICATION-TYPE
        OBJECTS { ibucCloneCommFault }
        STATUS current
        DESCRIPTION
        "This indicates the off line unit in a protected pair
        has timed out waiting for a clone update message."
        ::= {ibucEventsV2 33}

-- 1.3.6.1.4.1.21369.1.5.0.34
ibucSwitchOverEvent NOTIFICATION-TYPE
        OBJECTS { ibucSwitchPosition }
        STATUS current
        DESCRIPTION
        "This indicates a change in the online unit."
        ::= {ibucEventsV2 34}

--
-- Group definitions
--
		
ibucCfgGroup OBJECT-GROUP
        OBJECTS {
                ibucIPAddress,
                ibucIPGateway,
                ibucIPSubnet,
                ibucIPAddressOtherIBUC,
                ibucIPTelnetPort,
                ibucRS485Address,
                ibucRS485Baudrate,
                ibucRS485Mode,
                ibucRS485Delay,
                ibucTemperatureSuppressible,
                ibucInputLowThresholdSuppressible,
                ibucInputHighThresholdSuppressible,
                ibucOutputLowThresholdSuppressible,
                ibucOutputHighThresholdSuppressible,
                ibucTemperatureAlarmLevel,
                ibucInputLowThresholdAlarmLevel,
                ibucInputHighThresholdAlarmLevel,
                ibucOutputLowThresholdAlarmLevel,
                ibucOutputHighThresholdAlarmLevel,
                ibucVerboseMode,
                ibucEcho,
                ibucPasswordTimeOut,
                ibucWebServerRefresh,
                ibucFrequency,
                ibucPowerupState,
                ibucPowerupDelay,
                ibucReadPowerMode,
                ibucBurstThreshold,
                ibucBurstCount,
                ibucGainMode,
                ibucAttenuation,
                ibucInputThresholdLo,
                ibucInputThresholdHi,
                ibucOutputThresholdLo,
                ibucOutputThresholdHi,
                ibucHighTemperatureShutdown,
                ibucZAttenuation,
                ibucZLevelTarget,
                ibucZGainTarget
        }
        STATUS          current
        DESCRIPTION
        "The collection of objects which are used to provide
        the IBUC configuration parameters starting with 0.89
		revision firmware."
        ::= {  ibucGroups 1 }

ibucControlGroup OBJECT-GROUP
        OBJECTS {
                ibucSuppressAlarms,
                ibucSimulateAlarm,
                ibucClearAlarmLog,
                ibucMute,
                ibucResetGainControl,
                ibucFirmwareReboot
        }
        STATUS          current
        DESCRIPTION
        "The collection of objects which are used to provide
        the IBUC control parameters starting with 0.89
		revision firmware."
        ::= {  ibucGroups 2 }

ibucStatusGroup OBJECT-GROUP
        OBJECTS {
                ibucModelNumber,
                ibucSerialNumber,
                ibucFirmwareVersion,
                ibucPowerClass,
                ibucFrequencyBand,
                ibucDROLock,
                ibucAgcAlcNotSettled,
                ibucAgcAlcTargetOOR,
                ibucInputThresholdLow,
                ibucInputThresholdHigh,
                ibucOutputThresholdLow,
                ibucOutputThresholdHigh,
                ibuc10MHz,
                ibucAgcAlcRange,
                ibucTemperatureAlarm,
                ibucTxSimulated,
                ibucSupplyVoltageOor,
                ibucSupplyCurrentOor,
                ibucLogAlignError,
                ibucCfgDataError,
                ibucEthernetDownload,
                ibucSerialDownload,
                ibucFWReboot,
                ibucSupplyVoltage,
                ibucSupplyCurrent,
                ibucDROVoltage,
                ibucTemperature,
                ibucGainControl,
                ibucInputPowerLevel,
                ibucOutputPowerLevel,
                ibucAlarmLogNumber,
                ibucAlarmLogType,
                ibucAlarmLogAlarms
        }
        STATUS          current
        DESCRIPTION
        "The collection of objects which are used to provide
        the IBUC status information starting with 0.89
		revision firmware."
        ::= {  ibucGroups 3 }

ibucRedundancyGroup OBJECT-GROUP
        OBJECTS {
                ibucRedundancyEnabled,
                ibucRedundancyMode,
                ibucPositionOnSwitch,
                ibucAutoCloning,
                ibucSwitchingType,
                ibucSwitchPosition,
                ibucSystemStatus
        }
        STATUS          current
        DESCRIPTION
        "The collection of objects which are used to provide
        the IBUC redundant only parameters starting with 0.89
		revision firmware."
        ::= {  ibucGroups 4 }

ibucNotificationGroup NOTIFICATION-GROUP
        NOTIFICATIONS {
                ibucAlarmEvent,
                ibucAlarmClearEvent,
                ibucRebootEvent
        }
        STATUS          current
        DESCRIPTION
        "The notifier group starting with 0.89 revision firmware."
        ::= {  ibucGroups 5 }

ibucCfgV1dot14Group OBJECT-GROUP
        OBJECTS {
			ibucAC50HzCorrection,
			ibucInternal10MHzTrim
        }
        STATUS          current
        DESCRIPTION
        "Additional functionality added with 1.14
		revision firmware."
        ::= {  ibucGroups 6 }
		
ibucStatusV1dot19Group OBJECT-GROUP
        OBJECTS {
                ibucWGSwitchFault,
                ibucCloneCommFault,
                ibucCloneReadFault,
                ibucCloneWriteFault
        }
        STATUS          current
        DESCRIPTION
        "Additional functionality added with 1.19
		revision firmware."
        ::= {  ibucGroups 7 }
			
ibucNotificationV1dot19Group NOTIFICATION-GROUP
        NOTIFICATIONS {
                ibucRebootEvent,
                ibucDROLockMajorEvent,
                ibucDROLockClearEvent,
                ibucInputThresholdLowMajorEvent,
                ibucInputThresholdLowMinorEvent,
                ibucInputThresholdLowClearEvent,
                ibucInputThresholdHighMajorEvent,
                ibucInputThresholdHighMinorEvent,
                ibucInputThresholdHighClearEvent,
                ibucOutputThresholdLowMajorEvent,
                ibucOutputThresholdLowMinorEvent,
                ibucOutputThresholdLowClearEvent,
                ibucOutputThresholdHighMajorEvent,
                ibucOutputThresholdHighMinorEvent,
                ibucOutputThresholdHighClearEvent,
                ibuc10MHzMinorEvent,
                ibuc10MHzClearEvent,
                ibucTemperatureMajorEvent,
                ibucTemperatureMinorEvent,
                ibucTemperatureClearEvent,
                ibucTxSimulatedMajorEvent,
                ibucTxSimulatedClearEvent,
                ibucSupplyVoltageOorMinorEvent,
                ibucSupplyVoltageOorClearEvent,
                ibucWGSwitchFaultMajorEvent,
                ibucWGSwitchFaultClearEvent
        }
        STATUS          current
        DESCRIPTION
        "The notifier group starting with 1.19 firmware."
        ::= {  ibucGroups 8 }

        
ibucStatusV1dot27Group OBJECT-GROUP
        OBJECTS {
                ibucTotalSystemHours,
                ibucTotalTransmitHours
        }
        STATUS          current
        DESCRIPTION
        "The collection of objects which are used to provide
        the IBUC status information."
        ::= {  ibucGroups 9 }
   
ibucRedundancyV1dot37Group OBJECT-GROUP
        OBJECTS {
                ibucWarmStandby
        }
        STATUS          current
        DESCRIPTION
        "Additional functionality added with 1.37
		revision firmware."
        ::= {  ibucGroups 10 }   
  
ibucStatusV1dot38Group OBJECT-GROUP
        OBJECTS {
                ibuc10MHzSource
        }
        STATUS          current
        DESCRIPTION
        "Additional functionality starting with version 1.38
        firmware."
        ::= {  ibucGroups 11 }
 
ibucCfgV1dot39Group OBJECT-GROUP
        OBJECTS {
			ibucBurstTimeout
        }
        STATUS          current
        DESCRIPTION
        "Additional functionality added with 1.39
		revision firmware."
        ::= {  ibucGroups 12 }
 
ibucStatusV1dot42Group OBJECT-GROUP
        OBJECTS {
                ibucInputOverdriveFault
        }
        STATUS          current
        DESCRIPTION
        "Additional functionality starting with version 1.42
        firmware."
        ::= {  ibucGroups 13 }

ibucCfgV1dot52Group OBJECT-GROUP
        OBJECTS {
			ibucCouplingFactor
        }
        STATUS          current
        DESCRIPTION
        "Additional functionality added with 1.52
		revision firmware."
        ::= {  ibucGroups 14 }

ibucMonCtrlV2Group OBJECT-GROUP
		OBJECTS {
			ibucIPAddressOtherPublic,
			ibucRealTimeClock,
			ibucNtpIpAddr,
			ibucTimezoneOffset,
			ibucWebPageTitle,
			ibucEnableExtLED,
			ibucInternal10MHzV2Trim,
			ibucHardwareVersion,
			ibucRFRange,
			ibucIFRange,
			ibucLOFrequency,
			ibucSpectralInversion,
			ibucVoltageRange,
			ibucInternal10MHz,
			ibucTxMutedFault,
			ibucEventLogEvent,
			ibucClearStatLog,
			ibucStatLogInterval,
			ibucStatLogValue
		}
		STATUS	current
		DESCRIPTION
		"Additional functionality added with version 2 of the
		processor card. Version 2 can be identified by an IBUC
		serial number starting with TE80."
        ::= {  ibucGroups 15 }
		
ibucNotificationMCv2Group NOTIFICATION-GROUP
        NOTIFICATIONS {
			ibucInputOverdriveEvent,
			ibucTxMutedEvent,
			ibucAgcAlcRangeEvent,
			ibucAgcAlcTargetOOREvent,
			ibucCloneCommFaultEvent,
			ibucSwitchOverEvent
        }
        STATUS          current
        DESCRIPTION
        "The notifier group starting with 1.19 firmware."
        ::= {  ibucGroups 16 }

ibuc3Group OBJECT-GROUP
		OBJECTS {
			ibucKeylineDisable
		}
		STATUS	current
		DESCRIPTION
		"Additional functionality added with IBUC3. IBUC3 can be identified by an IBUC
		model number starting with IBA."
        ::= {  ibucGroups 17 }

ibucPoutOffsetGroup OBJECT-GROUP
		OBJECTS {
			ibucPoutOffset
		}
		STATUS	current
		DESCRIPTION
		"Added ability to offset the power out reading display."
        ::= {  ibucGroups 18 }

ibucTempShutThreshGroup OBJECT-GROUP
		OBJECTS {
			ibucTemperatureShutdownThreshold
		}
		STATUS	current
		DESCRIPTION
		"Added ability to offset the power out reading display."
        ::= {  ibucGroups 19 }

ibucTxLoadSwitchGroup OBJECT-GROUP
		OBJECTS {
			ibucTxLoadSwitch
		}
		STATUS	current
		DESCRIPTION
		"Added ability to control an external Waveguide switch
		for installing a tx load switch at a non-protected BUC."
        ::= {  ibucGroups 20 }

ibucMultiBandGroup OBJECT-GROUP
		OBJECTS {
			ibucTxMultiBandSelect,
			ibucInputFreqRngSelect
		}
		STATUS	current
		DESCRIPTION
		"Support for multiband Ka"
        ::= {  ibucGroups 21 }

