			sspaStatusInputThresholdLow,
			sspaStatusInputThresholdHigh,
			sspaStatusOuputThresholdLow,
			sspaStatusOutputThresholdHigh,
			sspaStatusAgcAlcRange,
			sspaStatusTemperatureAlarm,
			sspaStatusTxSimulated,
			sspaStatusVdcOor,
			sspaStatusIdcOor,
			sspaStatusLogAlignError,
			sspaStatusCfgDataError,
			sspaStatusEthernetDownload,
			sspaStatusSerialDownload,
			sspaStatusFWReboot,
			sspaStatusDCVoltage,
			sspaStatusDCCurrent,
			sspaStatusTemperature,
			sspaStatusGainControl,
			sspaStatusInputPowerLevel,
			sspaStatusOutputPowerLevel,
			sspaStatusAlarmLogNumber,
			sspaStatusAlarmLogType,
			sspaStatusAlarmLogAlarms
        }
        STATUS current
        DESCRIPTION
            "The collection of objects which are used to provide
             status information."
