--------------------------------------------------------------------------------
--- 
--- BUC Alarms Suppressible and Configuration
---
--------------------------------------------------------------------------------
tx21BucAlarmCfgTable OBJECT-TYPE
	SYNTAX			SEQUENCE OF Tx21BucAlarmCfgEntry
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"This is a table of alarm log entries."
	::= { tx21Alarm 1 }

tx21BucAlarmCfgEntry OBJECT-TYPE
	SYNTAX			Tx21BucAlarmCfgEntry
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"This is a table of alarm log entries."
	INDEX {tx21BucAlarmCfgIndex}
	::= { tx21BucAlarmCfgTable 1 }

Tx21BucAlarmCfgEntry ::= SEQUENCE {
	tx21BucAlarmCfgIndex			Integer32,
	tx21BucTempSuppressible			INTEGER,
	tx21BucInputLowSuppressible		INTEGER,
	tx21BucInputHighSuppressible	INTEGER,
	tx21BucOutputLowSuppressible	INTEGER,
	tx21BucOutputHighSuppressible	INTEGER,
	tx21BucTempAlarmLevel			INTEGER,
	tx21BucInputLowAlarmLevel		INTEGER,
	tx21BucInputHighAlarmLevel		INTEGER,
	tx21BucOutputLowAlarmLevel		INTEGER,
	tx21BucOutputHighAlarmLevel		INTEGER,
	tx21BucHighTempShutdown			INTEGER,
	tx21BucSuppressAlarms			INTEGER,
	tx21BucSimulateAlarm			INTEGER
}

tx21BucAlarmCfgIndex OBJECT-TYPE
	SYNTAX			Integer32 (1..3)
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies this
		alarm log entry."
	::= { tx21BucAlarmCfgEntry 1 }

tx21BucTempSuppressible OBJECT-TYPE
	SYNTAX			INTEGER {no(0), yes(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object configures temperature alarm suppression."
	::= { tx21BucAlarmCfgEntry 2 }

tx21BucInputLowSuppressible OBJECT-TYPE
	SYNTAX			INTEGER {no(0), yes(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object configures Input Low Threshold
		alarm suppression."
	::= { tx21BucAlarmCfgEntry 3 }

tx21BucInputHighSuppressible OBJECT-TYPE
	SYNTAX			INTEGER {no(0), yes(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object configures Input High Threshold
		alarm suppression."
	::= { tx21BucAlarmCfgEntry 4 }

tx21BucOutputLowSuppressible OBJECT-TYPE
	SYNTAX			INTEGER {no(0), yes(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object configures Output Low Threshold
		alarm suppression."
	::= { tx21BucAlarmCfgEntry 5 }

tx21BucOutputHighSuppressible OBJECT-TYPE
	SYNTAX			INTEGER {no(0), yes(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object configures Output High Threshold
		alarm suppression."
	::= { tx21BucAlarmCfgEntry 6 }

tx21BucTempAlarmLevel OBJECT-TYPE
	SYNTAX			INTEGER {none(0), minor(1), major(2)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object configures whether the Temperature alarm
		generates no alarm, a minor alarm, or a major alarm."
	::= { tx21BucAlarmCfgEntry 7 }

tx21BucInputLowAlarmLevel OBJECT-TYPE
	SYNTAX			INTEGER {none(0), minor(1), major(2)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object configures whether the Input Low Threshold 
		alarm generates no alarm, a minor alarm, or a major alarm."             
	::= { tx21BucAlarmCfgEntry 8 }

tx21BucInputHighAlarmLevel OBJECT-TYPE
	SYNTAX			INTEGER {none(0), minor(1), major(2)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object configures whether the Input High Threshold
		alarm generates no alarm, a minor alarm, or a major alarm."
	::= { tx21BucAlarmCfgEntry 9 }

tx21BucOutputLowAlarmLevel OBJECT-TYPE
	SYNTAX			INTEGER {none(0), minor(1), major(2)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object configures whether the Output Low Threshold
		alarm generates no alarm, a minor alarm, or a major alarm."
	::= { tx21BucAlarmCfgEntry 10 }

tx21BucOutputHighAlarmLevel OBJECT-TYPE
	SYNTAX			INTEGER {none(0), minor(1), major(2)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object configures whether the Output High Threshold
		alarm generates no alarm, a minor alarm, or a major alarm."
	::= { tx21BucAlarmCfgEntry 11 }

tx21BucHighTempShutdown OBJECT-TYPE
	SYNTAX			INTEGER {disable(0), enable(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		High Temperature Shutdown. Enables or disables the
		high temp TX shutdown when temperature exceeds ratings."
	::= { tx21BucAlarmCfgEntry 12 }

tx21BucSuppressAlarms OBJECT-TYPE
	SYNTAX			INTEGER {no(0), yes(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object causes configured threshold
		alarms to be suppressed."
	::= { tx21BucAlarmCfgEntry 13 }

tx21BucSimulateAlarm OBJECT-TYPE
	SYNTAX			INTEGER {no(0), yes(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object causes a major alarm
		in the IBUC."
	::= { tx21BucAlarmCfgEntry 14 }


