--------------------------------------------------------------------------------
---
--- BUC ALARM STATUS
---
--------------------------------------------------------------------------------
tx21BucAlarmTable OBJECT-TYPE
	SYNTAX			SEQUENCE OF Tx21BucAlarmEntry
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"This is a table of alarm log entries."
	::= { tx21Alarm 10 }

tx21BucAlarmEntry OBJECT-TYPE
	SYNTAX			Tx21BucAlarmEntry
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"This is a table of alarm log entries."
	INDEX {tx21BucAlarmIndex}
	::= { tx21BucAlarmTable 1 }

Tx21BucAlarmEntry ::= SEQUENCE {
	tx21BucAlarmIndex			Integer32,
	tx21BucDROLock				INTEGER,
	tx21BucInputThresholdLow	INTEGER,
	tx21BucInputThresholdHigh	INTEGER,
	tx21BucOutputThresholdLow	INTEGER,
	tx21BucOutputThresholdHigh	INTEGER,
	tx21BucTxSimulated			INTEGER,
	tx21BucTxMutedFault			INTEGER,
	tx21BucTemperatureAlarm		INTEGER,
	tx21Buc10MHz				INTEGER,
	tx21BucInputOverdriveFault	INTEGER
}

tx21BucAlarmIndex OBJECT-TYPE
	SYNTAX			Integer32 (1..3)
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies this
		alarm log entry."
	::= { tx21BucAlarmEntry 1 }

tx21BucDROLock OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2), disconnected(4)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of object identifies whether a 
		DRO lock alarm exists."
	::= { tx21BucAlarmEntry 2 }

tx21BucInputThresholdLow OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2), disconnected(4)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of object identifies whether a 
		Input Threshold Low alarm exists."
	::= { tx21BucAlarmEntry 3 }

tx21BucInputThresholdHigh OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2), disconnected(4)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of object identifies whether a 
		Input Threshold High alarm exists."
	::= { tx21BucAlarmEntry 4 }

tx21BucOutputThresholdLow OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2), disconnected(4)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of object identifies whether a 
		Output Threshold Low alarm exists."
	::= { tx21BucAlarmEntry 5 }

tx21BucOutputThresholdHigh OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2), disconnected(4)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of object identifies whether a 
		OutputThreshold High alarm exists."
	::= { tx21BucAlarmEntry 6 }

tx21BucTxSimulated OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2), disconnected(4)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of object identifies whether an 
		Tx Simulated alarm exists."
	::= { tx21BucAlarmEntry 7 }

tx21BucTxMutedFault OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2), disconnected(4)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"This identifies whether the transmitter
		is muted either by an alarm condition or
		the user disabling the transmitter."
	::= { tx21BucAlarmEntry 8 }

tx21BucTemperatureAlarm OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2), disconnected(4)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of object identifies whether an 
		high temperature alarm exists."
	::= { tx21BucAlarmEntry 9 }

tx21Buc10MHz OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2), disconnected(4)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of object identifies whether a 
		10 MHz alarm exists."
	::= { tx21BucAlarmEntry 10 }

tx21BucInputOverdriveFault OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2), disconnected(4)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of object identifies whether 
		the input power level is to high for a GaN unit."
	::= { tx21BucAlarmEntry 11 }



