TERRASAT-TX-2-1-MIB DEFINITIONS ::= BEGIN

IMPORTS
	terrasat                
		FROM TERRASAT-SMI-MIB
	OBJECT-GROUP, NOTIFICATION-GROUP, MODULE-COMPLIANCE
		FROM SNMPv2-CONF
	IpAddress, OBJECT-TYPE, MODULE-IDENTITY, Integer32, NOTIFICATION-TYPE
		FROM SNMPv2-SMI
	DisplayString, TEXTUAL-CONVENTION
		FROM SNMPv2-TC;

tx21MIB MODULE-IDENTITY
    LAST-UPDATED    "202605070000Z"
    ORGANIZATION    "Terrasat Communications, Inc."
    CONTACT-INFO
            "Terrasat Communications
            Customer Service

            Address: 315 Digital Dr
            Morgan Hill, CA  95037
            USA

            Tel: +1 408 782-5911

            E-mail: techsupport@terrasatinc.com"
    DESCRIPTION
        "The management MIB for TX1:2 products."

        REVISION        "202605070000Z"
        DESCRIPTION
                "Version 6"
    ::= { terrasat 6 }

tx21Info			OBJECT IDENTIFIER ::= { tx21MIB 1 }	
tx21Alarm			OBJECT IDENTIFIER ::= { tx21MIB 2 }
tx21Sensor			OBJECT IDENTIFIER ::= { tx21MIB 3 }
tx21Tx				OBJECT IDENTIFIER ::= { tx21MIB 4 }
tx21Redundancy		OBJECT IDENTIFIER ::= { tx21MIB 7 }


Tx21BucAlarm ::= TEXTUAL-CONVENTION
	STATUS			current
	DESCRIPTION
		"BUC alarm structure.
		0  - Undefined
		1  - Agc/Alc target out of range
		2  - Supply amperes
		3  - Input IF overdrive
		4  - Waveguide switch
		5  - Supply voltage
		6  - External 10MHz
		7  - Transmitter simulated
		8  - Temperature
		9  - Input threshold low
		10 - Input threshold high
		11 - Output threshold low
		12 - Output threshold high
		13 - DRO out of lock
		14 - Transmitter muted
		15 - AGC/ALC out of range"
	SYNTAX		BITS {	undef(0), agcalctgt(1), amps(2), ovrdrv(3),
						wg(4), volts(5), tenmeg(6), txsim(7),
						temp(8), inlo(9), inhi(10), outlo(11),
						outhi(12), dro(13), mute(14), agcalc(15) }
--
-- Information
--

--Info scalars--
tx21InfoScalars OBJECT IDENTIFIER ::= { tx21Info 1 }

tx21ModelNumber OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"This is the same as the model
		number barcode on the side of the IBUC."
	::= { tx21InfoScalars 1 }

tx21SerialNumber OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"This is the same as the serial
		number barcode on the side of the IBUC."
	::= { tx21InfoScalars 2 }

tx21FirmwareVersion OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The M&C firmware version."
	::= { tx21InfoScalars 3 }

tx21HardwareVersion OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The IBUC hardware version."
	::= { tx21InfoScalars 4 }

tx21Internal10MHz OBJECT-TYPE
	SYNTAX			Integer32 (0..2)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies whether internal 10MHz is 
		installed in this unit. If it is 2 then its redundant 10MHz."
	::= { tx21InfoScalars 5 }


-- Info Table --
tx21BucInfoTable OBJECT-TYPE
	SYNTAX			SEQUENCE OF Tx21BucInfoEntry
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"This is a table of alarm log entries."
	::= { tx21Info 2 }

tx21BucInfoEntry OBJECT-TYPE
	SYNTAX			Tx21BucInfoEntry
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"This is a table of alarm log entries."
	INDEX {tx21BucInfoIndex}
	::= { tx21BucInfoTable 1 }

Tx21BucInfoEntry ::= SEQUENCE {
	tx21BucInfoIndex			Integer32,
	tx21BucModelNumber			DisplayString,
	tx21BucSerialNumber			DisplayString,
	tx21BucFirmwareVersion		DisplayString,
	tx21BucHardwareVersion		DisplayString,
	tx21BucPowerWatts			INTEGER,
	tx21BucRFRange				DisplayString,
	tx21BucIFRange				DisplayString,
	tx21BucLOFrequency			DisplayString,
	tx21BucSpectralInvert		DisplayString,
	tx21BucInternal10MHz		INTEGER,
	tx21BucTotalSysHours		INTEGER
}

tx21BucInfoIndex OBJECT-TYPE
	SYNTAX			Integer32 (1..3)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies this
		alarm log entry."
	::= { tx21BucInfoEntry 1 }

tx21BucModelNumber OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"This is the same as the model
		number barcode on the side of the IBUC."
	::= { tx21BucInfoEntry 2 }

tx21BucSerialNumber OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"This is the same as the serial
		number barcode on the side of the IBUC."
	::= { tx21BucInfoEntry 3 }

tx21BucFirmwareVersion OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The M&C firmware version."
	::= { tx21BucInfoEntry 4 }

tx21BucHardwareVersion OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The IBUC hardware version."
	::= { tx21BucInfoEntry 5 }

tx21BucPowerWatts OBJECT-TYPE
	SYNTAX			Integer32
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		Power class of this IBUC."
	::= { tx21BucInfoEntry 6 }

tx21BucFrequencyBand OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"This is the RF frequency band of this unit."
	::= { tx21BucInfoEntry 7 }

tx21BucRFRange OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"This is the RF frequency range of this unit."
	::= { tx21BucInfoEntry 8 }

tx21BucIFRange OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"This is the IF frequency range of this unit."
	::= { tx21BucInfoEntry 9 }

tx21BucLOFrequency OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"This is the frequency of the local oscillator
		of this unit."
	::= { tx21BucInfoEntry 10 }
        
tx21BucSpectralInvert OBJECT-TYPE
	SYNTAX			DisplayString
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"This gives the type inversion of the unit."
	::= { tx21BucInfoEntry 11 }
        
tx21BucInternal10MHz OBJECT-TYPE
	SYNTAX			INTEGER {no(0), yes(1)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies whether
		internal 10MHz is installed in this unit."
	::= { tx21BucInfoEntry 12 }

tx21BucTotalSysHours OBJECT-TYPE
	SYNTAX			INTEGER
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		total operating hours of the unit."
	::= { tx21BucInfoEntry 13 }
				

