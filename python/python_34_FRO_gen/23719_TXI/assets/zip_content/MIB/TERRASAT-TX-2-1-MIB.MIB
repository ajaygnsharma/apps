--
-- Controller Alarm Status
--
--------------------------------------------------------------------------------
tx2110MHz OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"10MHz is too low."
	::= { tx21Alarm 12 }


tx21SwitchFaultA OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The switch connected to BUC A fault."
	::= { tx21Alarm 13 }

tx21SwitchFaultB OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The switch connected to BUC B fault."
	::= { tx21Alarm 14 }

tx21VoltLevel1 OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"Power supply #1 voltage is to low."
	::= { tx21Alarm 15 }

tx21VoltLevel2 OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"Power supply #2 voltage is to low."
	::= { tx21Alarm 16 }

tx21BUCAOffline OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"BUC A is offline."
	::= { tx21Alarm 17 }

tx21BUCBOffline OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"BUC B is offline."
	::= { tx21Alarm 18 }

tx21BUCSOffline OBJECT-TYPE
	SYNTAX			INTEGER {clear(0), minor(1), major(2)}
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"BUC S is offline."
	::= { tx21Alarm 19 }



--------------------------------------------------------------------------------
-- ____                                
--/ ___|  ___ _ __  ___  ___  _ __ ___ 
--\___ \ / _ \ '_ \/ __|/ _ \| '__/ __|
--___) |  __/ | | \__ \ (_) | |  \__ \
--|____/ \___|_| |_|___/\___/|_|  |___/
--
--------------------------------------------------------------------------------
tx21BucSensorTable OBJECT-TYPE
	SYNTAX			SEQUENCE OF Tx21BucSensorEntry
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"This is a table of alarm log entries."
	::= { tx21Sensor 1 }

tx21BucSensorEntry OBJECT-TYPE
	SYNTAX			Tx21BucSensorEntry
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"This is a table of alarm log entries."
	INDEX {tx21BucSensorIndex}
	::= { tx21BucSensorTable 1 }

Tx21BucSensorEntry ::= SEQUENCE {
	tx21BucSensorIndex			Integer32,
	tx21BucSupplyVoltage		Integer32,
	tx21BucSupplyCurrent		Integer32,
	tx21BucDROVoltage			Integer32,
	tx21BucTemperature			Integer32,
	tx21BucInputPowerLevel		Integer32,
	tx21BucOutputPowerLevel		Integer32,
}

tx21BucSensorIndex OBJECT-TYPE
	SYNTAX			Integer32 (1..3)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies this
		alarm log entry."
	::= { tx21BucSensorEntry 1 }

tx21BucSupplyVoltage OBJECT-TYPE
	SYNTAX			Integer32 (1..3000)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		AC/DC voltage level of the IBUC. Values range
		from 0 to 600 decivolts for DC supplied IBUCs
		and 0 to 3000 decivolts for AC supplied IBUCs."
	::= { tx21BucSensorEntry 2 }

tx21BucSupplyCurrent OBJECT-TYPE
	SYNTAX			Integer32 (1..250)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		AC/DC current consumption of the IBUC. Values range
		from 0 to 250 deciamps."
	::= { tx21BucSensorEntry 3 }

tx21BucDROVoltage OBJECT-TYPE
	SYNTAX			Integer32 (1..100)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		DRO voltage of the IBUC. Values range
		from 0 to 100 decivolts."
	::= { tx21BucSensorEntry 4 }

tx21BucTemperature OBJECT-TYPE
	SYNTAX			Integer32 (-127..100)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		internal temperature level of the IBUC. Values range
		from -50C to 100C in 1 degree C increments. -127 indicates
		out of range."
	::= { tx21BucSensorEntry 5 }

tx21BucInputPowerLevel OBJECT-TYPE
	SYNTAX			Integer32 (-6000..-1500)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		input power level of the IBUC. Values range
		from -1500 to -6000 millibels."
	::= { tx21BucSensorEntry 6 }


tx21BucOutputPowerLevel OBJECT-TYPE
	SYNTAX			Integer32 (-9900..6000)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		output power level of the IBUC. Values range
		from 0 to 6000 millibels.
		(-9600) IBUC Out of Lock.
		(-9900) IBUC is muted."
	::= { tx21BucSensorEntry 7 }




-- Controller Sensors --
tx21SupplyVolt1 OBJECT-TYPE
	SYNTAX			Integer32 (1..3000)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		AC/DC voltage level of the IBUC. Values range
		from 0 to 600 decivolts for DC supplied IBUCs
		and 0 to 3000 decivolts for AC supplied IBUCs."
	::= { tx21Sensor 2 }

tx21SupplyVolt2 OBJECT-TYPE
	SYNTAX			Integer32 (1..3000)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		AC/DC voltage level of the IBUC. Values range
		from 0 to 600 decivolts for DC supplied IBUCs
		and 0 to 3000 decivolts for AC supplied IBUCs."
	::= { tx21Sensor 3 }

tx21TenMHzLevel OBJECT-TYPE
	SYNTAX			Integer32 (0..4096)
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the
		10MHz level of the IBUC. Values range
		from 0 to 4096 ADC values."
	::= { tx21Sensor 4 }




--------------------------------------------------------------------------------
--  _______  __   ____             __ _       
--|_   _\ \/ /  / ___|___  _ __  / _(_) __ _ 
--  | |  \  /  | |   / _ \| '_ \| |_| |/ _` |
--  | |  /  \  | |__| (_) | | | |  _| | (_| |
--  |_| /_/\_\  \____\___/|_| |_|_| |_|\__, |
--                                     |___/ 
--------------------------------------------------------------------------------
tx21BucTxTable OBJECT-TYPE
	SYNTAX			SEQUENCE OF Tx21BucTxEntry
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"This is a table of alarm log entries."
	::= { tx21Tx 1 }

tx21BucTxEntry OBJECT-TYPE
	SYNTAX			Tx21BucTxEntry
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"This is a table of alarm log entries."
	INDEX {tx21BucTxIndex}
	::= { tx21BucTxTable 1 }

Tx21BucTxEntry ::= SEQUENCE {
	tx21BucTxIndex				Integer32,
	tx21BucTxEnable				INTEGER,
	tx21BucFrequency			Integer32,
	tx21BucPowerupState			INTEGER,
	tx21BucPowerupDelay			Integer32,
	tx21BucReadPowerMode		INTEGER,
	tx21BucBurstThreshold		Integer32,
	tx21BucGainMode				INTEGER,
	tx21BucAttenuation			Integer32,
	tx21BucInputThresholdLo		Integer32,
	tx21BucInputThresholdHi		Integer32,
	tx21BucOutputThresholdLo	Integer32,
	tx21BucOutputThresholdHi	Integer32,
	tx21BucInternal10MHzTrim	Integer32,
	tx21BucBurstTimeout			Integer32,
	tx21BucCouplingFactor		Integer32,
	tx21BucResetGainControl		INTEGER,
	tx21BucGainControl			Integer32
}

tx21BucTxIndex OBJECT-TYPE
	SYNTAX			Integer32 (1..3)
	MAX-ACCESS		not-accessible
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies this
		alarm log entry."
	::= { tx21BucTxEntry 1 }

tx21BucTxEnable OBJECT-TYPE
	SYNTAX			INTEGER {disable(0), enable(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object causes the transmitter to
		be muted."
	::= { tx21BucTxEntry 2 }

tx21BucFrequency OBJECT-TYPE
	SYNTAX			Integer32 (1..65535)
	UNITS			"megahertz"
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		monitored frequency in MHz at the output of the IBUC.
		This can be input as an IF or RF frequency inside the
		passband of the unit."
	::= { tx21BucTxEntry 3 }

tx21BucPowerupState OBJECT-TYPE
	SYNTAX			INTEGER {off(0), on(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		powerup state of the IBUC transmitter.
		(0) TX OFF
		(1) TX ON"
	::= { tx21BucTxEntry 4 }

tx21BucPowerupDelay OBJECT-TYPE
	SYNTAX			Integer32 (0..500)
	UNITS			"seconds"
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		powerup delay of the IBUC Transmitter before enabling.
		0-500 in 1 second intervals."
	::= { tx21BucTxEntry 5 }

tx21BucReadPowerMode OBJECT-TYPE
	SYNTAX			INTEGER {continuous(0), burst(1)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		mode the IBUC reports its output power level."
	::= { tx21BucTxEntry 6 }

tx21BucBurstThreshold OBJECT-TYPE
	SYNTAX			Integer32 (1..65535)
	UNITS			"millibels"
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		burst threshold setting of the IBUC. 0 to 6000 millibels
		further qualified by the power output range. Rated Power + 1
		to Rated Power - 20 db."
	::= { tx21BucTxEntry 7 }

tx21BucGainMode OBJECT-TYPE
	SYNTAX			INTEGER {open(0), alc(1), agc(2)}
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		gain mode of the IBUC."
	::= { tx21BucTxEntry 8 }

tx21BucAttenuation OBJECT-TYPE
	SYNTAX			Integer32 (0..3000)
	UNITS			"millibels"
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		attenuation setting of this IBUC. If the IBUC is 
		Option Z this has no meaning and writes will return
		snmp error.
		Ranges from 0 to 1600 millibels
		Option -002 0 to 2000 millibels
		IBR 0 to 3000 millibels"
	::= { tx21BucTxEntry 9 }

tx21BucInputThresholdLo OBJECT-TYPE
	SYNTAX			Integer32 (-6000..-1500)
	UNITS			"millibels"
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		Input Low Threshold setting in millibels for this IBUC.
		Range is -1500 to -6000.
		Must be below cfgInputThresholdHigh."
	::= { tx21BucTxEntry 10 }

tx21BucInputThresholdHi OBJECT-TYPE
	SYNTAX			Integer32 (-6000..-1500)
	UNITS			"millibels"
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		Input High Threshold setting in millibels for this IBUC. 
		Range is -1500 to -6000
		Must be above cfgInputThresholdLow."
	::= { tx21BucTxEntry 11 }

tx21BucOutputThresholdLo OBJECT-TYPE
	SYNTAX			Integer32 (0..6000)
	UNITS			"millibels"
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		Output Low Threshold setting in milliBels for this IBUC. 
		Range is 0 to 6000 further qualified by the output
		range of the IBUC(Rated Power to Rated Power - 20 db).
		Must be below cfgInputThresholdHigh."
	::= { tx21BucTxEntry 12 }

tx21BucOutputThresholdHi OBJECT-TYPE
	SYNTAX			Integer32 (0..6000)
	UNITS			"millibels"
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		Output High Threshold setting for this IBUC. 0 to 6000
		millibels. Further qualified by the output
		range of the IBUC(Rated Power+1dB to Rated Power - 20 dB).
		Must be above cfgOutputThresholdLow."
	::= { tx21BucTxEntry 13 }

tx21BucBurstTimeout OBJECT-TYPE
	SYNTAX			Integer32 (0..300)
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"This value modifies the burst time out period."
	::= { tx21BucTxEntry 14 }

tx21BucResetGainControl OBJECT-TYPE
	SYNTAX			INTEGER {yes(1)}
	MAX-ACCESS		write-only
	STATUS			current
	DESCRIPTION
		"The value of this object causes the Gain Control
		attenuator to be reset to 0 db. If this IBUC is 
		Option Z then this will return snmp error.
		(0) Reset Gain Control"
	::= { tx21BucTxEntry 15 }

tx21BucGainControl OBJECT-TYPE
	SYNTAX		Integer32 (0..3000)
	UNITS			"millibels"
	MAX-ACCESS		read-only
	STATUS			current
	DESCRIPTION
		"The value of this object identifies the current
		gain control attenuation setting of this IBUC. If this IBUC is 
		Option Z then this has no meaning and reads will return
		snmp error."
	::= { tx21BucTxEntry 16 }

--
-- Redundancy Configuration
--
tx21SwitchingType OBJECT-TYPE
	SYNTAX			DisplayString (SIZE (0..1))
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
	"The value of this object uniquely identifies the
	switching type of the IBUC. Possible values are
	A/M. A for Automatic and M for Manual"
	::= { tx21Redundancy 1 }

tx21SwitchAPosition OBJECT-TYPE
	SYNTAX			DisplayString (SIZE (0..5))
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		switch positon of the IBUC. Reading this variable
		shows the current waveguide switch position. Writing
		this variable changes the current switch position.
		Possible values are BUCA/SPARE"
	::= { tx21Redundancy 2 }

tx21SwitchBPosition OBJECT-TYPE
	SYNTAX			DisplayString (SIZE (0..5))
	MAX-ACCESS		read-write
	STATUS			current
	DESCRIPTION
		"The value of this object uniquely identifies the
		switch positon of the IBUC. Reading this variable
		shows the current waveguide switch position. Writing
		this variable changes the current switch position. 
		Possible values are BUCB/SPARE"
	::= { tx21Redundancy 3 }


END
