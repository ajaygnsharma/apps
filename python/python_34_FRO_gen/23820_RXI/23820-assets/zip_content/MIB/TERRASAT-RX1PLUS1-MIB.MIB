TERRASAT-RX1PLUS1-MIB DEFINITIONS ::= BEGIN

IMPORTS
	terrasat
		FROM TERRASAT-SMI-MIB
	OBJECT-GROUP, NOTIFICATION-GROUP, MODULE-COMPLIANCE
		FROM SNMPv2-CONF
	NoYesValue, AlarmLevel, MsgResponseMode,
	DisableEnableValue,	AlarmState, RedundancyMode,
	PositionAB, RedundSwitchType
		FROM TERRASAT-TC-MIB
	IpAddress, OBJECT-TYPE, MODULE-IDENTITY, Integer32, NOTIFICATION-TYPE
		FROM SNMPv2-SMI
	sysName
		FROM RFC1213-MIB
	DisplayString
        FROM SNMPv2-TC;

rx1plus1MIB MODULE-IDENTITY
    LAST-UPDATED    "201812200000Z"
    ORGANIZATION    "Terrasat Communications, Inc."
    CONTACT-INFO
            "Terrasat Communications
            Customer Service

            Address: 235 Vineyard Court
            Morgan Hill, CA  95037
            USA

            Tel: +1 408 782-2166

            E-mail: techsupport@terrasatinc.com"
    DESCRIPTION
        "The management MIB for RX1+1 products."
	REVISION	"201812200000Z"
	DESCRIPTION
		"Added variables for RX1+1 with serial numbers
		beginning with TE82."	
	REVISION	"201410280000Z"
	DESCRIPTION
		"Added -0009 current thresholds to descriptions."
	REVISION	"201306240000Z"
	DESCRIPTION
		"Added full descriptions to alarms."
	REVISION	"201006210000Z"
	DESCRIPTION
		"Added rx1plus110MHzAlarm"
	REVISION	"200909280000Z"
	DESCRIPTION
		"The intial version."
    ::= { terrasat 2 }

rx1plus1Cfg			OBJECT IDENTIFIER ::= { rx1plus1MIB 1 }
rx1plus1IP			OBJECT IDENTIFIER ::= { rx1plus1Cfg 1 }
rx1plus1RS485		OBJECT IDENTIFIER ::= { rx1plus1Cfg 2 }
rx1plus1Alarm		OBJECT IDENTIFIER ::= { rx1plus1Cfg 3 }
rx1plus1System		OBJECT IDENTIFIER ::= { rx1plus1Cfg 4 }
rx1plus1Rx			OBJECT IDENTIFIER ::= { rx1plus1Cfg 5 }
rx1plus1Redund		OBJECT IDENTIFIER ::= { rx1plus1Cfg 6 }
rx1plus1Control		OBJECT IDENTIFIER ::= { rx1plus1MIB 2 }
rx1plus1Status		OBJECT IDENTIFIER ::= { rx1plus1MIB 3 }
rx1plus1UnitInfo	OBJECT IDENTIFIER ::= { rx1plus1Status 1 }
rx1plus1Alarms		OBJECT IDENTIFIER ::= { rx1plus1Status 2 }
rx1plus1Detector	OBJECT IDENTIFIER ::= { rx1plus1Status 3 }
rx1plus1AlarmLog	OBJECT IDENTIFIER ::= { rx1plus1Status 4 }
rx1plus1StatLog		OBJECT IDENTIFIER ::= { rx1plus1Status 5 }
rx1plus1Conformance	OBJECT IDENTIFIER ::= { rx1plus1MIB 4 }
rx1plus1Compliances	OBJECT IDENTIFIER ::= { rx1plus1Conformance 1 }
rx1plus1Groups		OBJECT IDENTIFIER ::= { rx1plus1Conformance 2 }
rx1plus1Events		OBJECT IDENTIFIER ::= { rx1plus1MIB 5 }

--
-- The Config Group
--

--
-- ip Subtree
--

rx1plus1IPAddress	OBJECT-TYPE
	SYNTAX IpAddress
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This is the network IP address for this rx1plus1. Legal values are
	1.0.0.0 to 224.0.0.0 excluding the endpoints. xx.xx.xx.00
	and xx.xx.xx.255 are excluded also. This item requires an rx1plus1
	F/W reboot to take affect."
	::= { rx1plus1IP 1 }

rx1plus1IPGateway OBJECT-TYPE
	SYNTAX IpAddress
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This is the network IP gateway address for this rx1plus1. Legal 
	values are 1.0.0.0 to 224.0.0.0 excluding the endpoints.
	xx.xx.xx.00 and xx.xx.xx.255 are excluded also. This item 
	requires an rx1plus1 F/W reboot to take affect."
	::= { rx1plus1IP 2 }

rx1plus1IPSubnet OBJECT-TYPE
	SYNTAX Integer32 (8..30)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This is the network IP subnet mask for this RX1+1. Values range
	from 8 to 30. This is the number of 1 bits in the mask with 8 
	representing 255.0.0.0 and 30 representing 255.255.255.252.This 
	item requires an RX1+1 F/W reboot to take affect."
	::= { rx1plus1IP 3 }

rx1plus1IPTelnetPort OBJECT-TYPE
	SYNTAX Integer32 (1..65534)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This is the telnet port for this rx1plus1. Values can range from
	1 to 65534. This item requires an rx1plus1 F/W reboot to take
	effect."
	::= { rx1plus1IP 4 }

--
-- rs485 Subtree
--

rx1plus1RS485Address OBJECT-TYPE
	SYNTAX Integer32 (1..254)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This is 485 network address for this rx1plus1. Legal values are 
	1 to 254."
	::= { rx1plus1RS485 1 }

rx1plus1RS485Baudrate OBJECT-TYPE
	SYNTAX Integer32 (1200|2400|4800|9600|19200|38400|56700|115200)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This is the 485 baudrate of this rx1plus1.
	1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200"
	::= { rx1plus1RS485 2 }

rx1plus1RS485Delay OBJECT-TYPE
	SYNTAX Integer32 (1..255)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This is the RS485 line delay for this rx1plus1. Legal Values are
	1 to 255."
	::= { rx1plus1RS485 3 }

rx1plus1RS485Mode OBJECT-TYPE
        SYNTAX  INTEGER {ascii(0),binary(1)}
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "This is the RS485 protocol mode. Legal Values are
        (0) enable ASCII protocol
        (1) enable Terrasat binary mode."
        ::= { rx1plus1RS485 4 }
	
--
-- alarm Subtree
--

rx1plus1InputLowThresholdSuppressibleA OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures A Input Low Threshold
	alarm suppression.
	(0) disallow suppression
	(1) allow suppression"
	::= { rx1plus1Alarm 1 }

rx1plus1InputLowThresholdSuppressibleB OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures B Input Low Threshold
	alarm suppression.
	(0) disallow suppression
	(1) allow suppression"
	::= { rx1plus1Alarm 2 }

rx1plus1VDCLowThresholdSuppressibleA OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures A VDC Low Threshold
	alarm suppression.
	(0) disallow suppression
	(1) allow suppression"
	::= { rx1plus1Alarm 3 }

rx1plus1VDCLowThresholdSuppressibleB OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures B VDC Low Threshold
	alarm suppression.
	(0) disallow suppression
	(1) allow suppression"
	::= { rx1plus1Alarm 4 }

rx1plus1VDCHighThresholdSuppressibleA OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures A VDC High Threshold
	alarm suppression.
	(0) disallow suppression
	(1) allow suppression"
	::= { rx1plus1Alarm 5 }

rx1plus1VDCHighThresholdSuppressibleB OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures B VDC High Threshold
	alarm suppression.
	(0) disallow suppression
	(1) allow suppression"
	::= { rx1plus1Alarm 6 }

rx1plus1IDCLowThresholdSuppressibleA OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures A IDC Low Threshold
	alarm suppression.
	(0) disallow suppression
	(1) allow suppression"
	::= { rx1plus1Alarm 7 }

rx1plus1IDCLowThresholdSuppressibleB OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures B IDC Low Threshold
	alarm suppression.
	(0) disallow suppression
	(1) allow suppression"
	::= { rx1plus1Alarm 8 }

rx1plus1IDCHighThresholdSuppressibleA OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures A IDC High Threshold
	alarm suppression.
	(0) disallow suppression
	(1) allow suppression"
	::= { rx1plus1Alarm 9 }

rx1plus1IDCHighThresholdSuppressibleB OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures B IDC High Threshold
	alarm suppression.
	(0) disallow suppression
	(1) allow suppression"
	::= { rx1plus1Alarm 10 }

rx1plus1InputLowThresholdAlarmLevelA OBJECT-TYPE
	SYNTAX AlarmLevel
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the A Input Low Threshold 
	alarm generates no alarm, a minor alarm, or a major alarm.
	(0) no alarm
	(1) minor alarm
	(2) major alarm"             
	::= { rx1plus1Alarm 11 }

rx1plus1InputLowThresholdAlarmLevelB OBJECT-TYPE
	SYNTAX AlarmLevel
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the B Input Low Threshold 
	alarm generates no alarm, a minor alarm, or a major alarm.
	(0) no alarm
	(1) minor alarm
	(2) major alarm"             
	::= { rx1plus1Alarm 12 }

rx1plus1VDCLowThresholdAlarmLevelA OBJECT-TYPE
	SYNTAX AlarmLevel
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the A VDC Low Threshold 
	alarm generates no alarm, a minor alarm, or a major alarm.
	(0) no alarm
	(1) minor alarm
	(2) major alarm"             
	::= { rx1plus1Alarm 13 }

rx1plus1VDCLowThresholdAlarmLevelB OBJECT-TYPE
	SYNTAX AlarmLevel
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the B VDC Low Threshold 
	alarm generates no alarm, a minor alarm, or a major alarm.
	(0) no alarm
	(1) minor alarm
	(2) major alarm"             
	::= { rx1plus1Alarm 14 }

rx1plus1VDCHighThresholdAlarmLevelA OBJECT-TYPE
	SYNTAX AlarmLevel
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the A VDC High Threshold 
	alarm generates no alarm, a minor alarm, or a major alarm.
	(0) no alarm
	(1) minor alarm
	(2) major alarm"             
	::= { rx1plus1Alarm 15 }

rx1plus1VDCHighThresholdAlarmLevelB OBJECT-TYPE
	SYNTAX AlarmLevel
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the B VDC High Threshold 
	alarm generates no alarm, a minor alarm, or a major alarm.
	(0) no alarm
	(1) minor alarm
	(2) major alarm"             
	::= { rx1plus1Alarm 16 }

rx1plus1IDCLowThresholdAlarmLevelA OBJECT-TYPE
	SYNTAX AlarmLevel
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the A IDC Low Threshold 
	alarm generates no alarm, a minor alarm, or a major alarm.
	(0) no alarm
	(1) minor alarm
	(2) major alarm"             
	::= { rx1plus1Alarm 17 }

rx1plus1IDCLowThresholdAlarmLevelB OBJECT-TYPE
	SYNTAX AlarmLevel
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the B IDC Low Threshold 
	alarm generates no alarm, a minor alarm, or a major alarm.
	(0) no alarm
	(1) minor alarm
	(2) major alarm"             
	::= { rx1plus1Alarm 18 }

rx1plus1IDCHighThresholdAlarmLevelA OBJECT-TYPE
	SYNTAX AlarmLevel
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the A IDC High Threshold 
	alarm generates no alarm, a minor alarm, or a major alarm.
	(0) no alarm
	(1) minor alarm
	(2) major alarm"             
	::= { rx1plus1Alarm 19 }

rx1plus1IDCHighThresholdAlarmLevelB OBJECT-TYPE
	SYNTAX AlarmLevel
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the B IDC high Threshold 
	alarm generates no alarm, a minor alarm, or a major alarm.
	(0) no alarm
	(1) minor alarm
	(2) major alarm"             
	::= { rx1plus1Alarm 20 }

rx1plus110MHzAlarm OBJECT-TYPE
	SYNTAX DisableEnableValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object configures whether the 10MHz alarm is generated.
	(0) disable
	(1) enable"             
	::= { rx1plus1Alarm 21 }

--
-- system Subtree
--

rx1plus1VerboseMode OBJECT-TYPE
	SYNTAX MsgResponseMode
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object sets the response type for messages
	received utilizing the telnet command set.
	(0) Terse messages
	(1) Verbose messages"
	::= { rx1plus1System 1 }

rx1plus1Echo OBJECT-TYPE
	SYNTAX DisableEnableValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object sets the echo type for messages
	received utilizing the telnet command set.
	(0) No Echo
	(1) Echo"
	::= { rx1plus1System 2 }

rx1plus1PasswordTimeOut OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object sets the password timeout for all
	interfaces excluding snmp.
	(0) no password timeout
	(1..65535) number of minutes"
	::= { rx1plus1System 3 }

rx1plus1WebServerRefresh OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object sets the web server refresh rate
	(0) no refresh
	(1..3600) number of seconds"
	::= { rx1plus1System 4 }

rx1plus1RealTimeClock OBJECT-TYPE
	SYNTAX  DisplayString (SIZE (19))
	MAX-ACCESS      read-write
	STATUS  current
	DESCRIPTION
	"This is the real time clock.
	Format is MM/dd/yyyy hh:mm:ss.
	Time is based on 24 hour clock."
	::= { rx1plus1System 5 }
        
rx1plus1NtpIpAddr OBJECT-TYPE
	SYNTAX  IpAddress
	MAX-ACCESS      read-write
	STATUS  current
	DESCRIPTION
	"This is the NTP server IP address. Legal values are
	1.0.0.0 to 224.0.0.0 excluding the endpoints, network, loopback,
	and broadcast addresses."
	::= { rx1plus1System 6 }

rx1plus1TimezoneOffset OBJECT-TYPE
	SYNTAX  Integer32 (-720..840)
	UNITS	"Minutes"
	MAX-ACCESS      read-write
	STATUS  current
	DESCRIPTION
	"This is the offset for GMT served by NTP. It may range from
	GMT+14(840) to GMT-12(-720). Format is in minutes.
	No offset is 0."
	::= { rx1plus1System 7 }
	
rx1plus1WebPageTitle OBJECT-TYPE
	SYNTAX  DisplayString (SIZE (0..32))
	MAX-ACCESS      read-write
	STATUS  current
	DESCRIPTION
	"This is the user configurable title displayed at the top
	of web pages."
	::= { rx1plus1System 8 }
	
--
-- rx Subtree
--

rx1plus1InputThresholdLowA OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	Input Low Threshold setting in mB for this rx1plus1.
	Range is -4000 to 500."
	::= { rx1plus1Rx 1 }

rx1plus1InputThresholdLowB OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	Input Low Threshold setting in mB for this rx1plus1. 
	Range is -4000 to 500."
	::= { rx1plus1Rx 2 }

rx1plus1VDCHighThresholdA OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	Input High Threshold setting in mVolts for this rx1plus1. 
	Range is 1000 to 2500
	Must be greater than cfgVDCLowThresholdA."
	::= { rx1plus1Rx 3 }

rx1plus1VDCHighThresholdB OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	Input High Threshold setting in mVolts for this rx1plus1. 
	Range is 1000 to 2500
	Must be greater than cfgVDCLowThresholdB."
	::= { rx1plus1Rx 4 }

rx1plus1VDCLowThresholdA OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	Input Low Threshold setting in mVolts for this rx1plus1. 
	Range is 1000 to 2500
	Must be less than cfgVDCHighThresholdA."
	::= { rx1plus1Rx 5 }

rx1plus1VDCLowThresholdB OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	Input Low Threshold setting in mVolts for this rx1plus1. 
	Range is 1000 to 2500
	Must be less than cfgVDCHighThresholdB."
	::= { rx1plus1Rx 6 }

rx1plus1IDCHighThresholdA OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	Input High Threshold setting in mAmps for this rx1plus1. 
	Range is 100 to 600
	Model 310-10801-0009 Range is 100 to 1200
	Must be greater than cfgIDCLowThresholdA."
	::= { rx1plus1Rx 7 }

rx1plus1IDCHighThresholdB OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	Input High Threshold setting in mAmps for this rx1plus1. 
	Range is 100 to 600
	Model 310-10801-0009 Range is 100 to 1200
	Must be greater than cfgIDCLowThresholdB."
	::= { rx1plus1Rx 8 }

rx1plus1IDCLowThresholdA OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	Input Low Threshold setting in mAmps for this rx1plus1. 
	Range is 100 to 600
	Model 310-10801-0009 Range is 100 to 1200
	Must be less than cfgIDCHighThresholdA."
	::= { rx1plus1Rx 9 }

rx1plus1IDCLowThresholdB OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	Input Low Threshold setting in mAmps for this rx1plus1. 
	Range is 100 to 600
	Model 310-10801-0009 Range is 100 to 1200
	Must be less than cfgIDCHighThresholdB."
	::= { rx1plus1Rx 10 }

rx1plus1BandVolts OBJECT-TYPE
	SYNTAX INTEGER	{ volt24(0),volt18(1),volt15(2),volt13(3) }
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This changes LNB supply voltage for selecting bands."
	::= { rx1plus1Rx 11 }

rx1plus1Band22khz OBJECT-TYPE
	SYNTAX INTEGER	{off(0), on(1)}
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This enables 22KHz to LNB for selecting bands."
	::= { rx1plus1Rx 12 }

rx1plus1Trim10mhz1 OBJECT-TYPE
	SYNTAX Integer32 (0..4095)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This adjusts the frequency of the first internal
	10MHz card."
	::= { rx1plus1Rx 13 }

rx1plus1Trim10mhz2 OBJECT-TYPE
	SYNTAX Integer32 (0..4095)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This adjusts the frequency of the second internal
	10MHz card."
	::= { rx1plus1Rx 14 }

rx1plus1TenMHzEnable OBJECT-TYPE
	SYNTAX INTEGER	{auto(0), int1(1), int2(2)}
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"This allows the user to select either of the internal
	10MHz sources for maintenance. This is only available
	on units that have 2 internal 10MHz sources.
	0 - Automatic selection of source (Default).
	1 - Select internal 10MHz #1
	2 - Select internal 10MHz #2"
	::= { rx1plus1Rx 15 }
	
-- 
-- redund Subtree
--

rx1plus1RedundancyMode OBJECT-TYPE
	SYNTAX RedundancyMode
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	redundancy switching mode of rx1plus1.
	(0) Reverting
	(1) NonReverting"
	::= { rx1plus1Redund 1 }

rx1plus1SwitchingType OBJECT-TYPE
	SYNTAX RedundSwitchType
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	switching type of the rx1plus1.
	(0) Manual switching
	(1) Automatic switching"
	::= { rx1plus1Redund 2 }

rx1plus1SwitchPosition OBJECT-TYPE
	SYNTAX PositionAB
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	switch positon of the rx1plus1. Reading this variable
	shows the current waveguide switch position. Writing
	this variable changes the current switch position.
	(0) Switch position A
	(1) Switch position B"
	::= { rx1plus1Redund 3 }

rx1plus1SystemStatus OBJECT-TYPE
	SYNTAX OCTET STRING (SIZE (0..100))
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	redundant system status of the rx1plus1."
	::= { rx1plus1Redund 4 }

--
-- The Control Group
--

rx1plus1SuppressAlarmsA OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object causes configured threshold
	alarms to be suppressed.
	(0) No Suppression
	(1) Suppress configured threshold alarms"
	::= { rx1plus1Control 1 }

rx1plus1SuppressAlarmsB OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object causes configured threshold
	alarms to be suppressed.
	(0) No Suppression
	(1) Suppress configured threshold alarms"
	::= { rx1plus1Control 2 }

rx1plus1SimulateAlarmA OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object causes an A side major alarm
	in the rx1plus1.
	(0) No Alarm
	(1) Simulate a Tx alarm"
	::= { rx1plus1Control 3 }

rx1plus1SimulateAlarmB OBJECT-TYPE
	SYNTAX NoYesValue
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object causes a B side major alarm
	in the rx1plus1.
	(0) No Alarm
	(1) Simulate a Tx alarm"
	::= { rx1plus1Control 4 }

rx1plus1ClearAlarmLog OBJECT-TYPE
	SYNTAX Integer32 (0)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object causes the rx1plus1 to clear
	its alarm history.
	(0) Clear alarm history"
	::= { rx1plus1Control 5 }

rx1plus1FirmwareReboot OBJECT-TYPE
	SYNTAX Integer32 (0)
	MAX-ACCESS read-write
	STATUS current
	DESCRIPTION
	"The value of this object causes the firmware to
	restart. Writing this object will cause a momentary
	interruption to traffic.
	(0) Reboot Firmware"
	::= { rx1plus1Control 6 }

--
-- The Status Group
--


--
-- unitInfo Subtree
--

rx1plus1ModelNumber OBJECT-TYPE
	SYNTAX OCTET STRING (SIZE (0..20))
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	model number of this rx1plus1."
	::= { rx1plus1UnitInfo 1 }

rx1plus1SerialNumber OBJECT-TYPE
	SYNTAX OCTET STRING (SIZE (0..20))
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	serial number of this rx1plus1."
	::= { rx1plus1UnitInfo 2 }

rx1plus1FirmwareVersion OBJECT-TYPE
	SYNTAX OCTET STRING (SIZE (0..50))
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	Firmware Version of this rx1plus1."
	::= { rx1plus1UnitInfo 3 }

rx1plus1HardwareVersion OBJECT-TYPE
	SYNTAX DisplayString
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	Firmware Version of this rx."
	::= { rx1plus1UnitInfo 4 }

rx1plus1SupplyVoltRange OBJECT-TYPE
	SYNTAX DisplayString
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"AC or DC input voltage range."
	::= { rx1plus1UnitInfo 5 }
	
rx1plus1Provider OBJECT-TYPE
	SYNTAX DisplayString
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"This is the support entity to contact."
	::= { rx1plus1UnitInfo 6 }

