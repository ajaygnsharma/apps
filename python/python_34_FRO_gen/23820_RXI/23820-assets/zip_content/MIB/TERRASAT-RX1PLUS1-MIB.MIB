	DESCRIPTION
	"This trap is issued when the emergency override switch is 
	place in the override position."
	::= {rx1plus1EventsV2 38}

rx1plus1EmergencyOverrideOffEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"This trap is issued when the emergency override switch is 
	configured not to override."
	::= {rx1plus1EventsV2 39}

rx1plus1SwitchFaultMajorEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"This trap is issued if the position of the waveguide switch
	cannot be determined."
	::= {rx1plus1EventsV2 40}

rx1plus1SwitchFaultClearEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"This trap is issued in response to a previous alarm clearing."
	::= {rx1plus1EventsV2 41}

--
-- Compliances		
--

rx1plus1ComplianceV1  MODULE-COMPLIANCE
        STATUS     current
        DESCRIPTION 
                "The compliance statement starting with firmware
				revision 0.89."
        MODULE
                MANDATORY-GROUPS { 
                        rx1plus1CfgGroup,
						rx1plus1ControlGroup,
						rx1plus1StatusGroup,
						rx1plus1NotificationV0dot11Group
                } 
        ::= { rx1plus1Compliances 1 }

rx1plus1ComplianceV2  MODULE-COMPLIANCE
        STATUS     current
        DESCRIPTION 
                "The compliance statement starting with firmware
				revision 5.00."
        MODULE
                MANDATORY-GROUPS { 
                        rx1plus1CfgGroup,
						rx1plus1CfgV2Group,
						rx1plus1ControlGroup,
						rx1plus1StatusGroup,
						rx1plus1StatusV2Group,
						rx1plus1NotificationV0dot11Group
                } 
        ::= { rx1plus1Compliances 2 }
		
--
-- Group definitions
--
		
rx1plus1CfgGroup OBJECT-GROUP
	OBJECTS {
		rx1plus1IPAddress, rx1plus1IPGateway,
		rx1plus1IPSubnet, rx1plus1IPTelnetPort,
		rx1plus1RS485Address, rx1plus1RS485Baudrate,
		rx1plus1RS485Delay,	rx1plus1InputLowThresholdSuppressibleA,
		rx1plus1InputLowThresholdSuppressibleB,	rx1plus1VDCLowThresholdSuppressibleA,
		rx1plus1VDCLowThresholdSuppressibleB, rx1plus1VDCHighThresholdSuppressibleA,
		rx1plus1VDCHighThresholdSuppressibleB, rx1plus1IDCLowThresholdSuppressibleA,
		rx1plus1IDCLowThresholdSuppressibleB, rx1plus1IDCHighThresholdSuppressibleA,
		rx1plus1IDCHighThresholdSuppressibleB, rx1plus1InputLowThresholdAlarmLevelA,
		rx1plus1InputLowThresholdAlarmLevelB, rx1plus1VDCLowThresholdAlarmLevelA,
		rx1plus1VDCLowThresholdAlarmLevelB, rx1plus1VDCHighThresholdAlarmLevelA,
		rx1plus1VDCHighThresholdAlarmLevelB, rx1plus1IDCLowThresholdAlarmLevelA,
		rx1plus1IDCLowThresholdAlarmLevelB, rx1plus1IDCHighThresholdAlarmLevelA,
		rx1plus1IDCHighThresholdAlarmLevelB, rx1plus110MHzAlarm,
		rx1plus1VerboseMode, rx1plus1Echo,
		rx1plus1PasswordTimeOut, rx1plus1WebServerRefresh,
		rx1plus1InputThresholdLowA, rx1plus1InputThresholdLowB,
		rx1plus1VDCHighThresholdA, rx1plus1VDCHighThresholdB,
		rx1plus1VDCLowThresholdA, rx1plus1VDCLowThresholdB,
		rx1plus1IDCHighThresholdA, rx1plus1IDCHighThresholdB,
		rx1plus1IDCLowThresholdA, rx1plus1IDCLowThresholdB,
		rx1plus1RedundancyMode,	rx1plus1SwitchingType,
		rx1plus1SwitchPosition,	rx1plus1SystemStatus
	}
	STATUS		current
	DESCRIPTION
	"The collection of objects which are used to provide
	the RX1+1 configuration parameters."
	::= {  rx1plus1Groups 1 }

rx1plus1ControlGroup OBJECT-GROUP
	OBJECTS {
		rx1plus1SuppressAlarmsA, rx1plus1SuppressAlarmsB,
		rx1plus1SimulateAlarmA, rx1plus1SimulateAlarmB,
		rx1plus1ClearAlarmLog, rx1plus1FirmwareReboot
	}
	STATUS		current
	DESCRIPTION
	"The collection of objects which are used to provide
	the RX1+1 control parameters."
	::= {  rx1plus1Groups 2 }

rx1plus1StatusGroup OBJECT-GROUP
	OBJECTS {
		rx1plus1ModelNumber, rx1plus1SerialNumber,
		rx1plus1FirmwareVersion, rx1plus1InputThresholdALow,
		rx1plus1InputThresholdBLow, rx1plus110MHz,
		rx1plus1RxSimulatedA, rx1plus1RxSimulatedB,
		rx1plus1VdcLowAThreshold, rx1plus1VdcLowBThreshold,
		rx1plus1VdcHighAThreshold, rx1plus1VdcHighBThreshold,
		rx1plus1IdcLowAThreshold, rx1plus1IdcLowBThreshold,
		rx1plus1IdcHighAThreshold, rx1plus1IdcHighBThreshold,
		rx1plus1EmergencyOverride, rx1plus1SwitchFault,
		rx1plus1LogAlignError, rx1plus1CfgDataError,
		rx1plus1EthernetDownload, rx1plus1SerialDownload,
		rx1plus1FWReboot, rx1plus1DCVoltageA,
		rx1plus1DCVoltageB, rx1plus1DCCurrentA,
		rx1plus1DCCurrentB,	rx1plus1InputPowerLevelA,
		rx1plus1InputPowerLevelB, rx1plus1AlarmLogNumber,
		rx1plus1AlarmLogType, rx1plus1AlarmLogAlarms,
		rx1plus1TenMegLevel
	}
	STATUS		current
	DESCRIPTION
	"The collection of objects which are used to provide
	the RX1+1 status information."
	::= {  rx1plus1Groups 3 }

rx1plus1NotificationV0dot11Group NOTIFICATION-GROUP
	NOTIFICATIONS {
		rx1plus1RebootEvent,
		rx1plus1InputThresholdALowMajorEvent,
		rx1plus1InputThresholdALowMinorEvent,
		rx1plus1InputThresholdALowClearEvent,
		rx1plus1InputThresholdBLowMajorEvent,
		rx1plus1InputThresholdBLowMinorEvent,
		rx1plus1InputThresholdBLowClearEvent,
		rx1plus110MHzMinorEvent,
		rx1plus110MHzClearEvent,
		rx1plus1RxSimulatedAMajorEvent,
		rx1plus1RxSimulatedAClearEvent,
		rx1plus1RxSimulatedBMajorEvent,
		rx1plus1RxSimulatedBClearEvent,
		rx1plus1VdcLowAThresholdMajorEvent,
		rx1plus1VdcLowAThresholdMinorEvent,
		rx1plus1VdcLowAThresholdClearEvent,
		rx1plus1VdcLowBThresholdMajorEvent,
		rx1plus1VdcLowBThresholdMinorEvent,
		rx1plus1VdcLowBThresholdClearEvent,
		rx1plus1VdcHighAThresholdMajorEvent,
		rx1plus1VdcHighAThresholdMinorEvent,
		rx1plus1VdcHighAThresholdClearEvent,
		rx1plus1VdcHighBThresholdMajorEvent,
		rx1plus1VdcHighBThresholdMinorEvent,
		rx1plus1VdcHighBThresholdClearEvent,
		rx1plus1IdcLowAThresholdMajorEvent,
		rx1plus1IdcLowAThresholdMinorEvent,
		rx1plus1IdcLowAThresholdClearEvent,
		rx1plus1IdcLowBThresholdMajorEvent,
		rx1plus1IdcLowBThresholdMinorEvent,
		rx1plus1IdcLowBThresholdClearEvent,
		rx1plus1IdcHighAThresholdMajorEvent,
		rx1plus1IdcHighAThresholdMinorEvent,
		rx1plus1IdcHighAThresholdClearEvent,
		rx1plus1IdcHighBThresholdMajorEvent,
		rx1plus1IdcHighBThresholdMinorEvent,
		rx1plus1IdcHighBThresholdClearEvent,
		rx1plus1EmergencyOverrideOnEvent,
		rx1plus1EmergencyOverrideOffEvent,
		rx1plus1SwitchFaultMajorEvent,
		rx1plus1SwitchFaultClearEvent
	}
	STATUS		current
	DESCRIPTION
	"The notifier group starting with 0.11 firmware."
	::= {  rx1plus1Groups 4 }

rx1plus1StatusV2Group OBJECT-GROUP
	OBJECTS {
		rx1plus1HardwareVersion,
		rx1plus1SupplyVoltRange,
		rx1plus1Provider,
		rx1plus1EventLogAlarm,
		rx1plus1ClearStatLog,
		rx1plus1StatLogInterval,
		rx1plus1StatLogAlarm,
		rx1plus1Internal10MHz1
	}
	STATUS		current
	DESCRIPTION
	"Additional status objects."
	::= {  rx1plus1Groups 5 }

rx1plus1CfgV2Group OBJECT-GROUP
	OBJECTS {
		rx1plus1RealTimeClock,
		rx1plus1NtpIpAddr,
		rx1plus1TimezoneOffset,
		rx1plus1WebPageTitle,
		rx1plus1BandVolts,
		rx1plus1Band22khz,
		rx1plus1Trim10mhz1,
		rx1plus1Trim10mhz2,
		rx1plus1TenMHzEnable,
		rx1plus1RS485Mode
	}
	STATUS		current
	DESCRIPTION
	"The collection of objects which are used to provide
	the RX1+1 configuration parameters."
	::= {  rx1plus1Groups 6 }
	
