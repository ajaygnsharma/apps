	this value will alert the user to a possible
	failure of internal 10MHz #1.
	(0) No Alarm
	(1) Alarm
	(2) Informational
	(3) Minor
	(4) Major
	"
	::= { rx1plus1Alarms 21 }

--
-- detector Subtree
--

rx1plus1DCVoltageA OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	A DC voltage level of the rx1plus1. Values range
	from 100 to 250 representing 10.00 to 25.00 volts
	in .1 volt increments."
	::= { rx1plus1Detector 1 }

rx1plus1DCVoltageB OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	B DC voltage level of the rx1plus1. Values range
	from 100 to 250 representing 10.00 to 25.00 volts
	in .1 volt increments."
	::= { rx1plus1Detector 2 }

rx1plus1DCCurrentA OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	A DC current consumption of the rx1plus1. Values range
	from 100 miliamps to 600 milliamps."
	::= { rx1plus1Detector 3 }

rx1plus1DCCurrentB OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	B DC current consumption of the rx1plus1. Values range
	from 100 miliamps to 600 milliamps."
	::= { rx1plus1Detector 4 }

rx1plus1InputPowerLevelA OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	A input power level of the rx1plus1. Values range
	from -4000 to 500 representing -40.00 to 5.00 dbm."
	::= { rx1plus1Detector 5 }

rx1plus1InputPowerLevelB OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	B input power level of the rx1plus1. Values range
	from -4000 to 500 representing -40.00 to 5.00 dbm."
	::= { rx1plus1Detector 6 }

rx1plus1TenMegLevel OBJECT-TYPE
	SYNTAX Integer32
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object identifies the
	current 10MHz source level. Divide by 10
	for floating point level in dBm"
	::= { rx1plus1Detector 7 }
	
--
-- alarmsLog Subtree
--

rx1plus1AlarmLogNumber OBJECT-TYPE
	SYNTAX Integer32 (0..40)
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies the
	current number of alarm log entries."
	::= { rx1plus1AlarmLog 1 }

rx1plus1AlarmLogTable OBJECT-TYPE
	SYNTAX SEQUENCE OF Rx1plus1AlarmLogEntry
	MAX-ACCESS not-accessible
	STATUS current
	DESCRIPTION
	"This is a table of alarm log entries."
	::= { rx1plus1AlarmLog 2 }

rx1plus1AlarmLogEntry OBJECT-TYPE
	SYNTAX Rx1plus1AlarmLogEntry
	MAX-ACCESS not-accessible
	STATUS current
	DESCRIPTION
	"This is a table of alarm log entries."
	INDEX {rx1plus1AlarmLogIndex}
	::= { rx1plus1AlarmLogTable 1 }

Rx1plus1AlarmLogEntry ::= SEQUENCE {
	rx1plus1AlarmLogIndex	Integer32,
	rx1plus1AlarmLogType	INTEGER,
	rx1plus1AlarmLogAlarms	Integer32
}

rx1plus1AlarmLogIndex OBJECT-TYPE
	SYNTAX Integer32 (1..40)
	MAX-ACCESS not-accessible
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies this
	alarm log entry."
	::= { rx1plus1AlarmLogEntry 1 }

rx1plus1AlarmLogType OBJECT-TYPE
	SYNTAX INTEGER {rx(0), misc(1)}
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies this
	alarm log entry's alarm type
	(0) Rx Alarms
	(1) Misc Alarms."
	::= { rx1plus1AlarmLogEntry 2 }

rx1plus1AlarmLogAlarms OBJECT-TYPE
	SYNTAX Integer32 (1..65535)
	MAX-ACCESS read-only
	STATUS current
	DESCRIPTION
	"The value of this object uniquely identifies this
	alarm log entry's alarms. The values of this entry
	are based on the value of alarmsLogType above.
	If the value is Rx Alarms then the following bitmap applies:

	(0x0001) A input level low
	(0x0002) B input level low
	(0x0004) A simulated alarm
	(0x0008) B simulated alarm
	(0x0010) 10 MHz reference
	(0x0020) A VDC threshold low
	(0x0040) A VDC threshold high
	(0x0080) B VDC threshold low
	(0x0100) B VDC threshold high
	(0x0200) Waveguide switch fault
	(0x0400) A IDC threshold low
	(0x0800) A IDC threshold high
	(0x1000) B IDC threshold low
	(0x2000) B IDC threshold high
	(0x4000) Emergency override switch
	(0x8000) Value of 0 indicates this is RX alarms.

	If the value ov alarmsLogType is Misc Alarms then
	the following bitmap applies:

	(0x0001) Event log corrupted
	(0x0002) Configuration reset
	(0x0004) Ethernet download
	(0x0008) Serial download
	(0x0010) Reboot
	(0xFFE0) Not used"
	::= { rx1plus1AlarmLogEntry 3 }

rx1plus1EventLogTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF Rx1plus1EventLogEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "This is a table of alarm log entries."
        ::= { rx1plus1AlarmLog 3 }

rx1plus1EventLogEntry OBJECT-TYPE
        SYNTAX  Rx1plus1EventLogEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "This is a table of alarm log entries."
        INDEX {rx1plus1EventLogIndex}
        ::= { rx1plus1EventLogTable 1 }

Rx1plus1EventLogEntry ::= SEQUENCE {
        rx1plus1EventLogIndex                Integer32,
        rx1plus1EventLogAlarm                DisplayString
}

rx1plus1EventLogIndex OBJECT-TYPE
        SYNTAX  Integer32 (1..1000)
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "Index to the table."
        ::= { rx1plus1EventLogEntry 1 }

rx1plus1EventLogAlarm OBJECT-TYPE
        SYNTAX  DisplayString
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies this
        alarm log entry's alarm."
        ::= { rx1plus1EventLogEntry 2 }

--
-- StatsLog Subtree
--

rx1plus1ClearStatLog OBJECT-TYPE
        SYNTAX  NoYesValue
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "The value of this object causes the RX to clear
        its statistics history."
        ::= { rx1plus1StatLog 1 }

rx1plus1StatLogInterval OBJECT-TYPE
        SYNTAX  Integer32 (1..1440)
        MAX-ACCESS      read-write
        STATUS  current
        DESCRIPTION
        "Statistics collection interval
		1 minute to 1440 minutes."
        ::= { rx1plus1StatLog 2 }
		
rx1plus1StatLogTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF Rx1plus1StatLogEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "This is a table of statistics log entries."
        ::= { rx1plus1StatLog 3 }

rx1plus1StatLogEntry OBJECT-TYPE
        SYNTAX  Rx1plus1StatLogEntry
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "This is a table of statistics log entries."
        INDEX {rx1plus1StatLogIndex}
        ::= { rx1plus1StatLogTable 1 }

Rx1plus1StatLogEntry ::= SEQUENCE {
        rx1plus1StatLogIndex                Integer32,
        rx1plus1StatLogAlarm                DisplayString
}

rx1plus1StatLogIndex OBJECT-TYPE
        SYNTAX  Integer32 (1..1000)
        MAX-ACCESS      not-accessible
        STATUS  current
        DESCRIPTION
        "Index to the table."
        ::= { rx1plus1StatLogEntry 1 }

rx1plus1StatLogAlarm OBJECT-TYPE
        SYNTAX  DisplayString
        MAX-ACCESS      read-only
        STATUS  current
        DESCRIPTION
        "The value of this object identifies above
		statistics entry.
		Format:
		date time Pout Pin Temperature DRO Volts Amps 10MHz
		Example:
		01/01/2000 09:08:23 47.5 -35.9 25 5.5 48.0 2.5 -10.8"
        ::= { rx1plus1StatLogEntry 2 }
		
		
--
-- Notifications
--		
rx1plus1EventsV2	OBJECT IDENTIFIER ::= { rx1plus1Events 0 }

rx1plus1RebootEvent NOTIFICATION-TYPE
	OBJECTS { 
		sysName
	}
	STATUS current
	DESCRIPTION
	"The trap is issued on cold or warm startup of firmware."
	::= {rx1plus1EventsV2 1}

rx1plus1InputThresholdALowMajorEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"The trap is issued if the input level for LNB A drops below
	the configured threshold and the alarm is configured as a major."
	::= {rx1plus1EventsV2 2}

rx1plus1InputThresholdALowMinorEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"The trap is issued if the input level for LNB A drops below
	the configured threshold and the alarm is configured as a minor."
	::= {rx1plus1EventsV2 3}

rx1plus1InputThresholdALowClearEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"This trap is issued in response to a previous alarm clearing."
	::= {rx1plus1EventsV2 4}

rx1plus1InputThresholdBLowMajorEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"The trap is issued if the input level for LNB B drops below
	the configured threshold and the alarm is configured as a major."
	::= {rx1plus1EventsV2 5}

rx1plus1InputThresholdBLowMinorEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"The trap is issued if the input level for LNB B drops below
	the configured threshold and the alarm is configured as a minor."
	::= {rx1plus1EventsV2 6}

rx1plus1InputThresholdBLowClearEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"This trap is issued in response to a previous alarm clearing."
	::= {rx1plus1EventsV2 7}

rx1plus110MHzMinorEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"This trap is issued when the 10MHz level falls below the
	threshold."
	::= {rx1plus1EventsV2 8}

rx1plus110MHzClearEvent NOTIFICATION-TYPE
	STATUS current
	DESCRIPTION
	"This trap is issued in response to a previous alarm clearing."
	::= {rx1plus1EventsV2 9}

rx1plus1RxSimulatedAMajorEvent NOTIFICATION-TYPE
